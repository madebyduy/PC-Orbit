<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Local-first store (spec 6.8, 18.1). SQLite because the event log is
    append-only and must survive a crash mid-transaction and a reboot.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PcOrbit.Store</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PcOrbit.Core\PcOrbit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

</Project>
