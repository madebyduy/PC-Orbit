<Window x:Class="PcOrbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Height="941" Width="1672" MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource PageBg}" UseLayoutRounding="True"
        Loaded="OnLoaded" Closed="OnClosed">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="54" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================================================== SIDEBAR -->
    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SideBg}"
            BorderBrush="{StaticResource White}" BorderThickness="0,0,1,0" Padding="16,20,16,12">
      <DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,16">
          <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource LogoBg}">
            <Path Data="M 20,10 L 30,15.8 L 30,25.2 L 20,31 L 10,25.2 L 10,15.8 Z"
                  Fill="#F2F7FF" Stretch="Uniform" Margin="9" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="AppTitle" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" />
            <TextBlock x:Name="AppTagline" FontSize="11" Foreground="{StaticResource Faint}" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border Style="{StaticResource Card}" Padding="14" CornerRadius="16">
            <StackPanel>
              <Border Height="58" CornerRadius="10" Background="#0A1B3A">
                <Ellipse Width="46" Height="46">
                  <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                      <GradientStop Color="#93C5FD" Offset="0" />
                      <GradientStop Color="#3B82F6" Offset="0.55" />
                      <GradientStop Color="#1E40AF" Offset="1" />
                    </RadialGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
              </Border>
              <TextBlock x:Name="MachineName" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Ink}"
                         TextWrapping="Wrap" Margin="0,9,0,0" />
              <TextBlock x:Name="MachineOs" Style="{StaticResource Tiny}" Margin="0,3,0,0" />
              <TextBlock x:Name="MachineUptime" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
              <TextBlock x:Name="MachineTier" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="8,12,0,0">
            <Button x:Name="LangVi" Style="{StaticResource SecondaryButton}" Height="30" Padding="14,0" Content="VI" Click="OnLangVi" />
            <Button x:Name="LangEn" Style="{StaticResource SecondaryButton}" Height="30" Padding="14,0" Content="EN" Margin="8,0,0,0" Click="OnLangEn" />
            <Path Data="{StaticResource IconMoon}" Width="17" Height="17" Stretch="Uniform" Margin="16,0,0,0"
                  Stroke="#5B6B80" StrokeThickness="1.5" VerticalAlignment="Center" />
            <Path Data="{StaticResource IconCog}" Width="17" Height="17" Stretch="Uniform" Margin="14,0,0,0"
                  Stroke="#5B6B80" StrokeThickness="1.5" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
          <StackPanel>
            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Tag="{StaticResource IconHome}" IsChecked="True" Checked="OnNavChanged" />
            <RadioButton x:Name="NavStatus" Style="{StaticResource NavItem}" Tag="{StaticResource IconShield}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavPerf" Style="{StaticResource NavItem}" Tag="{StaticResource IconGauge}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavPlan" Style="{StaticResource NavItem}" Tag="{StaticResource IconSpark}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="{StaticResource IconClock}" Checked="OnNavChanged" />
            <Border Height="1" Background="#33FFFFFF" Margin="12,8" />
            <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}" Tag="{StaticResource IconWrench}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavRepair" Style="{StaticResource NavItem}" Tag="{StaticResource IconTools}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavUpdates" Style="{StaticResource NavItem}" Tag="{StaticResource IconRefresh}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavHardware" Style="{StaticResource NavItem}" Tag="{StaticResource IconChip}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavDrivers" Style="{StaticResource NavItem}" Tag="{StaticResource IconDriver}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Tag="{StaticResource IconGrid}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavAutomation" Style="{StaticResource NavItem}" Tag="{StaticResource IconAuto}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavBackup" Style="{StaticResource NavItem}" Tag="{StaticResource IconBackup}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" Tag="{StaticResource IconTools}" Checked="OnNavChanged" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ============================================================== MAIN -->
    <Grid Grid.Row="0" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- top bar -->
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnCaptionDrag">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="26,0,0,0" VerticalAlignment="Center">
          <Border Height="46" Width="560" CornerRadius="23" Background="{StaticResource White}">
            <Border.Effect>
              <DropShadowEffect Color="#1E4078" Opacity="0.07" BlurRadius="22" ShadowDepth="6" Direction="270" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
              <Path Data="{StaticResource IconSearch}" Width="16" Height="16" Stretch="Uniform"
                    Stroke="#8A99AD" StrokeThickness="1.6" />
              <TextBlock x:Name="SearchHint" FontSize="13.5" Foreground="#8A99AD" Margin="10,0,0,0" VerticalAlignment="Center" />
              <Border Background="#F1F5FA" CornerRadius="6" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Ctrl K" FontSize="11.5" Foreground="#7B8A9E" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
          <Border Style="{StaticResource RoundIcon}" Margin="0,0,10,0">
            <Path Data="{StaticResource IconGauge}" Width="18" Height="18" Stretch="Uniform" Stroke="#44546A" StrokeThickness="1.6" />
          </Border>
          <Grid Margin="0,0,10,0">
            <Border Style="{StaticResource RoundIcon}">
              <Path Data="{StaticResource IconBell}" Width="17" Height="17" Stretch="Uniform" Stroke="#44546A" StrokeThickness="1.6" />
            </Border>
            <Border x:Name="AlertBadge" Background="#EF4444" CornerRadius="9" Padding="5,1" HorizontalAlignment="Right"
                    VerticalAlignment="Top" BorderBrush="White" BorderThickness="2" Visibility="Collapsed">
              <TextBlock x:Name="AlertCount" FontSize="10" FontWeight="Bold" Foreground="White" />
            </Border>
          </Grid>
          <Border Style="{StaticResource RoundIcon}" Margin="0,0,14,0">
            <TextBlock Text="?" FontSize="16" FontWeight="Bold" Foreground="#44546A"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Button Style="{StaticResource CaptionButton}" Tag="M 1,6 L 11,6" Click="OnMinimize" />
          <Button Style="{StaticResource CaptionButton}" Tag="M 1,1 L 11,1 L 11,11 L 1,11 Z" Click="OnMaximize" />
          <Button Style="{StaticResource CaptionButton}" Tag="M 1,1 L 11,11 M 11,1 L 1,11" Click="OnClose" />
        </StackPanel>
      </Grid>

      <!-- ========================================================== views -->
      <Grid Grid.Row="1">

        <!-- ================================= DASHBOARD -->
        <ScrollViewer x:Name="ViewDashboard" VerticalScrollBarVisibility="Auto" Padding="26,0,26,18">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="RescanBtn" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="OnRescan" />
              <StackPanel>
                <TextBlock x:Name="DashTitle" Style="{StaticResource H1}" />
                <TextBlock x:Name="DashSub" Style="{StaticResource Sub}" Margin="0,4,20,0" />
              </StackPanel>
            </DockPanel>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- hero -->
              <Border Grid.Column="0" Style="{StaticResource Card}" Background="{StaticResource HeroBg}" Padding="20,14">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="92" Height="92" VerticalAlignment="Center">
                    <Ellipse Width="84" Height="84">
                      <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.33,0.28">
                          <GradientStop Color="#E0E7FF" Offset="0" />
                          <GradientStop Color="#818CF8" Offset="0.42" />
                          <GradientStop Color="#7C3AED" Offset="0.78" />
                          <GradientStop Color="#3B0764" Offset="1" />
                        </RadialGradientBrush>
                      </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="34" Height="19" Fill="#7AFFFFFF" Margin="14,20,0,0"
                             HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                      <Ellipse.RenderTransform><RotateTransform Angle="-24" /></Ellipse.RenderTransform>
                    </Ellipse>
                  </Grid>
                  <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeroLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock x:Name="HeroState" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" />
                      <Border x:Name="HeroBadge" Width="21" Height="21" CornerRadius="11" Background="{StaticResource Good}"
                              Margin="10,0,0,0" VerticalAlignment="Center">
                        <Path x:Name="HeroBadgeGlyph" Data="{StaticResource IconCheck}" Width="11" Height="11" Stretch="Uniform"
                              Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" />
                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="HeroDetail" Style="{StaticResource Sub}" Margin="0,5,0,0" MaxWidth="470" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button x:Name="HeroFixBtn" Style="{StaticResource PrimaryButton}" Height="34" Click="OnHeroFix" />
                      <Button x:Name="HeroDetailBtn" Style="{StaticResource SecondaryButton}" Height="34" Margin="10,0,0,0" Click="OnHeroDetails" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- health rail -->
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="HealthTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                  <StackPanel Orientation="Horizontal">
                    <Grid Width="112" Height="112">
                      <Ellipse Width="96" Height="96" Stroke="#E8EEF7" StrokeThickness="10" />
                      <Ellipse x:Name="HealthRing" Width="96" Height="96" StrokeThickness="10"
                               Stroke="{StaticResource AccentBar}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                               RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                      </Ellipse>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="HealthScoreText" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" />
                        <TextBlock Text="/100" FontSize="11" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,-4,0,0" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="HealthLabel" FontSize="17" FontWeight="ExtraBold" Foreground="{StaticResource Good}" />
                      <TextBlock x:Name="HealthNote" Style="{StaticResource Tiny}" MaxWidth="150" Margin="0,3,0,0" />
                    </StackPanel>
                  </StackPanel>
                  <Border Height="1" Background="{StaticResource Hair}" Margin="0,10,0,6" />
                  <ItemsControl x:Name="HealthChecks">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,3">
                          <Border DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="8" Background="{Binding Tone}">
                            <Path Data="{Binding Glyph}" Width="9" Height="9" Stretch="Uniform" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" />
                          </Border>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#44546A" Margin="9,0,8,0" VerticalAlignment="Center" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock x:Name="FindingsSect" Style="{StaticResource Sect}" />
            <ItemsControl x:Name="FindingsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,11" Padding="20,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="11" Background="{Binding Tone}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconSpark}" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{Binding Accent}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                      </Border>
                      <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Benefit}" FontSize="13" Foreground="#33333A" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Safety}" FontSize="13" Foreground="#33333A" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Cost}" Style="{StaticResource Tiny}" Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                          <Button Content="{Binding FixLabel}" Tag="{Binding OutcomeId}" Visibility="{Binding FixVisible}"
                                  Style="{StaticResource PrimaryButton}" Click="OnFindingFix" />
                          <Border Style="{StaticResource Chip}" Background="{StaticResource Hair}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Evidence}" FontSize="11" Foreground="{StaticResource Muted}" />
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- live strip: four gauges, straight from the machine -->
            <ItemsControl x:Name="DashGauges" Margin="0,0,0,16">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{Binding Tone}">
                          <Path Data="{Binding Glyph}" Width="15" Height="15" Stretch="Uniform"
                                Stroke="{Binding Accent}" StrokeThickness="1.6" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="ExtraBold"
                                 Foreground="{Binding Accent}" Margin="0,7,0,0" />
                      <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Percent}"
                                   Foreground="{Binding Accent}" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Note}" Style="{StaticResource Tiny}" Margin="0,5,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.15*" />
              </Grid.ColumnDefinitions>

              <!-- top processes -->
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="ProcTitle" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="ProcHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProcColName" Grid.Column="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" />
                    <TextBlock x:Name="ProcColCpu" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" TextAlignment="Right" />
                    <TextBlock x:Name="ProcColRam" Grid.Column="2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" TextAlignment="Right" />
                  </Grid>
                  <TextBlock x:Name="ProcEmpty" Style="{StaticResource Tiny}" Visibility="Collapsed" />
                  <ItemsControl x:Name="ProcList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{Binding RowBg}" CornerRadius="8" Padding="9,6" Margin="0,2">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="70" />
                              <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                              <Border Width="20" Height="20" CornerRadius="6" Background="{Binding Tone}">
                                <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="Bold"
                                           Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Ink}"
                                         Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Cpu}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{Binding Accent}" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Ram}" FontSize="12.5" Foreground="{StaticResource Muted}"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- connected devices -->
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="DevTitle" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="DevHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <ItemsControl x:Name="DeviceGroups">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,9">
                          <TextBlock Text="{Binding Group}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,0,0,3" />
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Style="{StaticResource FlatCard}" Padding="10,7" Margin="0,0,8,8" MaxWidth="260">
                                  <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="8" Background="{Binding Tone}" VerticalAlignment="Center">
                                      <Path Data="{Binding Glyph}" Width="13" Height="13" Stretch="Uniform"
                                            Stroke="{Binding Accent}" StrokeThickness="1.6" />
                                    </Border>
                                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                      <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource Faint}"
                                                 TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                    </StackPanel>
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="DevEmpty" Style="{StaticResource Tiny}" Visibility="Collapsed" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- storage · security · startup · network: four dense cards of read-only context -->
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="StorageTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,9" />
                  <ItemsControl x:Name="DriveList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,9">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Free}" FontSize="11.5" Foreground="{StaticResource Faint}" />
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                          </DockPanel>
                          <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Percent}"
                                       Foreground="{Binding Accent}" Margin="0,5,0,0" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="SecurityTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,9" />
                  <ItemsControl x:Name="SecurityRows">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,7">
                          <Border DockPanel.Dock="Left" Width="16" Height="16" CornerRadius="8" Background="{Binding Tone}">
                            <Path Data="{Binding Glyph}" Width="9" Height="9" Stretch="Uniform" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" />
                          </Border>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#44546A" Margin="9,0,8,0" VerticalAlignment="Center" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,9">
                    <TextBlock x:Name="StartupCount" DockPanel.Dock="Right" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="StartupTitle" Style="{StaticResource CardTitle}" />
                  </DockPanel>
                  <ItemsControl x:Name="StartupList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,6">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                          <Border Width="18" Height="18" CornerRadius="6" Background="{Binding Tone}" DockPanel.Dock="Left">
                            <TextBlock Text="{Binding Initial}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Ink}"
                                     Margin="8,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="StartupHint" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="6" Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Name="NetTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,9" />
                  <ItemsControl x:Name="NetRows">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,7">
                          <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource Faint}" Width="74" />
                          <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock x:Name="OutcomesSect" Style="{StaticResource Sect}" Margin="0,6,0,8" />
            <ItemsControl x:Name="OutcomeCards">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource FlatCard}" Width="360" MinHeight="130" Margin="0,0,12,12">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Tiny}" Margin="0,5,0,0" TextWrapping="Wrap" />
                      <Button Content="{Binding OpenLabel}" Tag="{Binding Id}" Style="{StaticResource PrimaryButton}"
                              Height="32" Padding="16,0" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnFindingFix" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= SYSTEM STATUS -->
        <ScrollViewer x:Name="ViewStatus" VerticalScrollBarVisibility="Auto" Padding="26,0,26,18" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="StatusTitle" Style="{StaticResource H1}" />
            <TextBlock x:Name="StatusSub" Style="{StaticResource Sub}" Margin="0,4,0,14" />

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoft}">
                      <Path Data="{StaticResource IconClock}" Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.6" />
                    </Border>
                    <TextBlock x:Name="UptimeLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock x:Name="UptimeValue" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" Margin="0,7,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoft}">
                      <Grid Width="17" Height="17">
                        <Rectangle Fill="#0078D4" Width="7.2" Height="7.2" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Rectangle Fill="#0078D4" Width="7.2" Height="7.2" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        <Rectangle Fill="#0078D4" Width="7.2" Height="7.2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Rectangle Fill="#0078D4" Width="7.2" Height="7.2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                      </Grid>
                    </Border>
                    <TextBlock x:Name="OsLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock x:Name="OsValue" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" Margin="0,7,0,0" TextWrapping="Wrap" />
                  <TextBlock x:Name="OsBuild" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource GoodSoft}">
                      <Path Data="{StaticResource IconShield}" Width="17" Height="17" Stretch="Uniform" Stroke="{StaticResource Good}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                    </Border>
                    <TextBlock x:Name="EncryptionLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock x:Name="EncryptionValue" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" Margin="0,7,0,0" />
                  <TextBlock x:Name="EncryptionNote" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock x:Name="HardwareSect" Style="{StaticResource Sect}" />
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="11" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentSoft}">
                      <Path Data="{StaticResource IconChip}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.6" />
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="CPU" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                      <TextBlock x:Name="CpuName" Style="{StaticResource Tiny}" MaxWidth="180" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="CpuValue" Style="{StaticResource BigValue}" Foreground="{StaticResource Accent}" Margin="0,8,0,0" />
                  <Polyline x:Name="CpuSpark" Stroke="{StaticResource Accent}" StrokeThickness="2" Height="30" Margin="0,4,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource VioletSoft}">
                      <Path Data="{StaticResource IconRam}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Violet}" StrokeThickness="1.6" />
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="RAM" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                      <TextBlock x:Name="RamSpeed" Style="{StaticResource Tiny}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="RamValue" Style="{StaticResource BigValue}" Foreground="{StaticResource Violet}" Margin="0,8,0,0" />
                  <ProgressBar x:Name="RamBar" Style="{StaticResource ThinBar}" Foreground="{StaticResource VioletBar}" Margin="0,6,0,0" />
                  <TextBlock x:Name="RamDetail" Style="{StaticResource Tiny}" Margin="0,5,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource OrangeSoft}">
                      <Path Data="{StaticResource IconDisk}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Orange}" StrokeThickness="1.6" />
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="DiskTitle" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                      <TextBlock x:Name="DiskName" Style="{StaticResource Tiny}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="DiskValue" Style="{StaticResource BigValue}" Foreground="{StaticResource Orange}" Margin="0,8,0,0" />
                  <ProgressBar x:Name="DiskBar" Style="{StaticResource ThinBar}" Foreground="{StaticResource OrangeBar}" Margin="0,6,0,0" />
                  <TextBlock x:Name="DiskDetail" Style="{StaticResource Tiny}" Margin="0,5,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="6" Style="{StaticResource Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource CyanSoft}">
                      <Path Data="{StaticResource IconMonitor}" Width="16" Height="16" Stretch="Uniform" Stroke="{StaticResource Cyan}" StrokeThickness="1.6" />
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="DisplayTitle" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                      <TextBlock x:Name="DisplayMax" Style="{StaticResource Tiny}" />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="DisplayValue" Style="{StaticResource BigValue}" Foreground="{StaticResource Cyan}" Margin="0,8,0,0" />
                  <TextBlock x:Name="DisplayNote" Style="{StaticResource Tiny}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock x:Name="ActivitySect" Style="{StaticResource Sect}" />
            <ItemsControl x:Name="ActivityTiles" Margin="0,0,0,14">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,11,0">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                      <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{Binding Accent}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- full hardware inventory, grouped -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="InventoryTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="InventoryHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="InventoryGroups">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Group}" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource FlatCard}" Padding="12,9" Margin="0,0,10,10" MinWidth="240" MaxWidth="330">
                                <StackPanel Orientation="Horizontal">
                                  <Border Width="30" Height="30" CornerRadius="9" Background="{Binding Tone}" VerticalAlignment="Center">
                                    <Path Data="{Binding Glyph}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{Binding Accent}" StrokeThickness="1.6" />
                                  </Border>
                                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Faint}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                  </StackPanel>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <TextBlock x:Name="ReadingsTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="ReadingsHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="ReadingsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding RowBg}" CornerRadius="8" Padding="10,7" Margin="0,2">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding Accent}" />
                          <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= PERFORMANCE -->
        <ScrollViewer x:Name="ViewPerf" VerticalScrollBarVisibility="Auto" Padding="26,0,26,18" Visibility="Collapsed">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                  <TextBlock x:Name="LiveChip" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="6,0,0,0" />
                </StackPanel>
              </Border>
              <StackPanel>
                <TextBlock x:Name="PerfTitle" Style="{StaticResource H1}" />
                <TextBlock x:Name="PerfSub" Style="{StaticResource Sub}" Margin="0,4,20,0" />
              </StackPanel>
            </DockPanel>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                  <TextBlock x:Name="CpuChartTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="CpuChartValue" FontSize="34" FontWeight="ExtraBold" Foreground="{StaticResource Accent}" Margin="0,6,0,0" />
                  <Grid Height="150" Margin="0,8,0,0">
                    <Border Background="#F7F9FD" CornerRadius="10" />
                    <Polyline x:Name="CpuChart" Stroke="{StaticResource Accent}" StrokeThickness="2.4" Margin="8" />
                  </Grid>
                  <TextBlock x:Name="CpuChartHint" Style="{StaticResource Tiny}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                  <TextBlock x:Name="RamChartTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="RamChartValue" FontSize="34" FontWeight="ExtraBold" Foreground="{StaticResource Violet}" Margin="0,6,0,0" />
                  <Grid Height="150" Margin="0,8,0,0">
                    <Border Background="#F9F7FD" CornerRadius="10" />
                    <Polyline x:Name="RamChart" Stroke="{StaticResource Violet}" StrokeThickness="2.4" Margin="8" />
                  </Grid>
                  <TextBlock x:Name="RamChartHint" Style="{StaticResource Tiny}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <ItemsControl x:Name="PerfTiles">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                      <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{Binding Accent}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <TextBlock x:Name="PerfProcTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="PerfProcHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="PerfProcList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding RowBg}" CornerRadius="8" Padding="10,7" Margin="0,2">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="7" Background="{Binding Tone}">
                              <TextBlock Text="{Binding Initial}" FontSize="10.5" FontWeight="Bold"
                                         Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Ink}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Pid}" FontSize="11" Foreground="{StaticResource Faint}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                          </StackPanel>
                          <ProgressBar Grid.Column="1" Style="{StaticResource ThinBar}" Value="{Binding CpuPercent}"
                                       Foreground="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,14,0" />
                          <TextBlock Grid.Column="2" Text="{Binding Cpu}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" TextAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding Ram}" FontSize="13" Foreground="{StaticResource Muted}"
                                     TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock x:Name="PerfHonestyTitle" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="PerfHonestyBody" Style="{StaticResource Sub}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= PLAN & APPLY -->
        <ScrollViewer x:Name="ViewPlan" VerticalScrollBarVisibility="Auto" Padding="26,0,26,18" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="PlanTitle" Style="{StaticResource H1}" />
            <TextBlock x:Name="PlanSub" Style="{StaticResource Sub}" Margin="0,4,0,14" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ComboBox x:Name="OutcomeBox" Width="440" DisplayMemberPath="Title" SelectionChanged="OnOutcomeChanged" />
                  <Button x:Name="CompileBtn" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnCompile" />
                </StackPanel>
                <TextBlock x:Name="OutcomeDescription" Style="{StaticResource Sub}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <StackPanel x:Name="PlanResultArea" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock x:Name="PlanCost" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                  <TextBlock x:Name="PlanIrreversible" FontSize="12.5" Foreground="{StaticResource Warn}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  <TextBlock x:Name="PlanBasedOn" Style="{StaticResource Tiny}" Margin="0,6,0,0" />
                  <TextBlock x:Name="PlanHash" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <Border x:Name="PlanNotesCard" Style="{StaticResource Card}" Background="{StaticResource WarnSoft}" BorderBrush="#F3DEBB" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="PlanNotesTitle" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Warn}" />
                  <TextBlock x:Name="PlanNotes" FontSize="12.5" Foreground="#5A4632" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <ItemsControl x:Name="PhasesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,11">
                      <StackPanel>
                        <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{StaticResource RowBg}" CornerRadius="10" Padding="13,10" Margin="0,3">
                                <StackPanel>
                                  <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Change}" FontSize="13" Foreground="#33333A" Margin="0,3,0,0" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Why}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Tiny}" Margin="0,3,0,0" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="DryRunBox" IsChecked="True" Checked="OnApplyModeChanged" Unchecked="OnApplyModeChanged" />
                  <CheckBox x:Name="RecoveryKeyBox" Margin="0,9,0,0" Checked="OnRecoveryAck" Unchecked="OnRecoveryAck" />
                  <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Height="42" Padding="24,0" Margin="0,14,0,0" Click="OnApply" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Border x:Name="RunResultCard" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ResultHeading" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="ResultCounts" FontSize="13" Foreground="#33333A" Margin="0,7,0,0" TextWrapping="Wrap" />
                <ItemsControl x:Name="ResultList" Margin="0,9,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource RowBg}" CornerRadius="10" Padding="12,9" Margin="0,3">
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{Binding Tone}">
                            <TextBlock Text="{Binding Symbol}" FontSize="12" FontWeight="Bold" Foreground="{Binding Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Margin="11,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="ResultNext" FontSize="12.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,9,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= HISTORY -->
        <ScrollViewer x:Name="ViewHistory" VerticalScrollBarVisibility="Auto" Padding="26,0,26,18" Visibility="Collapsed">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <Button x:Name="HistoryRefreshBtn" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="OnHistoryRefresh" />
              <StackPanel>
                <TextBlock x:Name="HistoryTitle" Style="{StaticResource H1}" />
                <TextBlock x:Name="HistorySub" Style="{StaticResource Sub}" Margin="0,4,20,0" />
              </StackPanel>
            </DockPanel>

            <TextBlock x:Name="TxSect" Style="{StaticResource Sect}" />
            <TextBlock x:Name="TxEmpty" Style="{StaticResource Sub}" Margin="0,0,0,12" Visibility="Collapsed" />
            <ItemsControl x:Name="TxList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="{Binding UndoLabel}" Tag="{Binding Id}" Visibility="{Binding UndoVisible}"
                              Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="OnUndoTransaction" />
                      <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="11" Background="{Binding Tone}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconClock}" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Accent}" StrokeThickness="1.6" />
                      </Border>
                      <StackPanel Margin="13,0,12,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,6,0,0">
              <StackPanel>
                <TextBlock x:Name="EventsTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                <TextBlock x:Name="EventsEmpty" Style="{StaticResource Sub}" Visibility="Collapsed" />
                <ItemsControl x:Name="EventsList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding RowBg}" CornerRadius="8" Padding="10,7" Margin="0,2">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding When}" FontSize="11.5" Foreground="{StaticResource Faint}" />
                          <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                          <TextBlock Grid.Column="2" Text="{Binding Change}" FontSize="12" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= NOT IN v0.1 -->
        <Grid x:Name="ViewSoon" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" MaxWidth="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="34,30">
            <StackPanel>
              <Border Width="52" Height="52" CornerRadius="16" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                <Path Data="{StaticResource IconWrench}" Width="24" Height="24" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Round" />
              </Border>
              <TextBlock x:Name="SoonModule" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" Margin="0,16,0,0" />
              <TextBlock x:Name="SoonBody" Style="{StaticResource Sub}" Margin="0,8,0,0" />
              <TextBlock x:Name="SoonPhase" Style="{StaticResource Tiny}" Margin="0,12,0,0" />
              <Button x:Name="SoonBackBtn" Style="{StaticResource SoftButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Padding="18,0" Height="36" Click="OnSoonBack" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- busy overlay -->
        <Border x:Name="BusyOverlay" Background="#88EAF1FB" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,22">
            <StackPanel Orientation="Horizontal">
              <ProgressBar IsIndeterminate="True" Width="140" Height="6" VerticalAlignment="Center" />
              <TextBlock x:Name="BusyText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Border>
      </Grid>
    </Grid>

    <!-- ============================================================== STATUS BAR -->
    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#99FFFFFF" BorderBrush="{StaticResource White}" BorderThickness="0,1,0,0">
      <ItemsControl x:Name="StatusStrip" Margin="30,0" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="28" Height="28" CornerRadius="9" Background="{Binding Tone}">
                <Ellipse Width="9" Height="9" Fill="{Binding Accent}" />
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                <TextBlock Text="{Binding Value}" FontSize="11.5" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
  </Grid>
</Window>
