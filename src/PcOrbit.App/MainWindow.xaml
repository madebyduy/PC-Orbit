<Window x:Class="PcOrbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Height="941" Width="1672" MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource PageBg}" UseLayoutRounding="True"
        Loaded="OnLoaded" Closed="OnClosed">

  <!--
    CornerRadius agrees with what RoundedWindow asks DWM for, rather than being left at zero.
    With glass off, WPF's chrome clips the window to a region of its own built from this value, and
    a square region is the one thing that can defeat the compositor's rounding. Setting both means
    the corner is round whichever of the two ends up drawing it.
  -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="8" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <!--
      One row now. The status bar that used to sit under everything is gone: of its five items,
      four were already on screen — the version and the elevation state in the sidebar, the
      Windows edition on the machine card, the scan time in the header — and the fifth, drive
      encryption, belongs with the other protections rather than in furniture.
    -->
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="290" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================================================== SIDEBAR -->
    <!--
      A dark rail against a bright canvas. The contrast is the point: it separates "where am I"
      from "what does it say", and it keeps the readings the brightest thing on screen.

      Fourteen flat destinations became twelve grouped ones, and every one of them now renders real
      data. The seven that used to lead to a "not in this version" placeholder are gone rather than
      greyed out — a menu that mostly does not work teaches people not to trust the menu.
    -->
    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SideFill}" Padding="14,18,10,14">
      <DockPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="7,0,0,10">
          <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource LogoBg}">
            <Path Data="M 20,10 L 30,15.8 L 30,25.2 L 20,31 L 10,25.2 L 10,15.8 Z"
                  Fill="#FFFFFF" Stretch="Uniform" Margin="9" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="AppTitle" FontSize="16.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
            <TextBlock x:Name="AppTagline" FontSize="10.5" Foreground="{StaticResource SideMuted}" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <!--
            The machine, in the space a machine name needs. The previous card carried four lines of
            explanation and a paragraph about administrator rights, which pushed the last two nav
            items off the screen — the footer was competing with the navigation for the one thing
            the navigation is for. The explanation now lives in a tooltip on the button that acts
            on it.
          -->
          <Border Background="#FFFFFF" BorderBrush="{StaticResource SideHair}" BorderThickness="1"
                  CornerRadius="8" Padding="12,10">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4" Background="{StaticResource Good}"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="MachineName" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                           Margin="8,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="MachineOs" FontSize="11" Foreground="{StaticResource SideMuted}"
                         Margin="16,3,0,0" TextTrimming="CharacterEllipsis" />
              <Button x:Name="ElevateBtn" Style="{StaticResource RowButton}" Margin="0,10,0,0"
                      HorizontalAlignment="Stretch" Click="OnElevate" />
              <!-- Shown instead of the button once this copy has rights: the state, not a call to act. -->
              <TextBlock x:Name="ElevatedBadge" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Good}"
                         Margin="0,10,0,0" Visibility="Collapsed" />
              <!-- For someone who lives in the BIOS page. Off by default: a UAC prompt per launch is a cost. -->
              <CheckBox x:Name="AlwaysElevateBox" Margin="2,9,0,0" FontSize="11.5"
                        Foreground="{StaticResource SideMuted}" Click="OnAlwaysElevateChanged" />
            </StackPanel>
          </Border>

          <!--
            Language as two chips, the active one lit. Radio semantics because the choice is one-of,
            and a full name rather than a code: "VI" is what a developer calls it.
          -->
          <DockPanel Margin="2,10,0,0">
            <TextBlock x:Name="AppVersionLabel" DockPanel.Dock="Right" FontSize="10.5"
                       Foreground="{StaticResource Faint}" VerticalAlignment="Center" Margin="10,0,4,0" />
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="LangVi" Style="{StaticResource FilterChip}" GroupName="Lang" Click="OnLangVi" />
              <RadioButton x:Name="LangEn" Style="{StaticResource FilterChip}" GroupName="Lang" Click="OnLangEn" />
            </StackPanel>
          </DockPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Margin="0,4,0,10">
          <StackPanel>
            <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" BorderBrush="#2563EB" Tag="{StaticResource GlyphHome}" IsChecked="True" Checked="OnNavChanged" />
            <RadioButton x:Name="NavMachine" Style="{StaticResource NavItem}" BorderBrush="#4F46E5" Tag="{StaticResource GlyphHardware}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavProtect" Style="{StaticResource NavItem}" BorderBrush="#047857" Tag="{StaticResource GlyphSecurity}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavTune" Style="{StaticResource NavItem}" BorderBrush="#0891B2" Tag="{StaticResource GlyphCleanup}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" BorderBrush="#DB2777" Tag="{StaticResource GlyphList}" Checked="OnNavChanged" />
            <RadioButton x:Name="NavChanges" Style="{StaticResource NavItem}" BorderBrush="#D97706" Tag="{StaticResource GlyphTimeline}" Checked="OnNavChanged" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ============================================================== MAIN -->
    <Grid Grid.Row="0" Grid.Column="1" ClipToBounds="True">
      <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--
        top bar

        The search box that used to live here searched nothing, and the "Ctrl K" badge beside it
        did nothing either. Decorative affordances are the fastest way to make a real tool feel
        like a mockup, so the space now carries what the user actually needs on every page: which
        page they are on, and how fresh the reading behind it is.
      -->
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnCaptionDrag">
        <StackPanel HorizontalAlignment="Left" Margin="30,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Style="{StaticResource H2}" />
          <TextBlock x:Name="PageSubtitle" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
          <Border Background="{StaticResource White}" BorderBrush="{StaticResource Hair}" BorderThickness="1"
                  CornerRadius="9" Padding="12,6" Margin="0,0,10,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconClock}" Width="13" Height="13" Stretch="Uniform"
                    Stroke="{StaticResource Faint}" StrokeThickness="1.5" VerticalAlignment="Center" />
              <TextBlock x:Name="LastScanLabel" FontSize="11.5" Foreground="{StaticResource Muted}"
                         Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Grid Margin="0,0,10,0" VerticalAlignment="Center">
            <Button x:Name="TopRescan" Style="{StaticResource SecondaryButton}" Height="34" Padding="14,0"
                    Click="OnRescan" />
            <Border x:Name="AlertBadge" Background="{StaticResource Bad}" CornerRadius="9" Padding="5,1"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                    BorderBrush="White" BorderThickness="2" Visibility="Collapsed">
              <TextBlock x:Name="AlertCount" FontSize="10" FontWeight="Bold" Foreground="White" />
            </Border>
          </Grid>

          <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconMinimize}" Click="OnMinimize" />
          <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconMaximize}" Click="OnMaximize" />
          <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource IconClose}" Click="OnClose" />
        </StackPanel>
      </Grid>

      <!-- ========================================================== views -->
      <!--
        Sub-navigation. Filled from the section table in code rather than written out here: the
        pages a section holds is one fact, and a hand-written strip beside a hand-written table is
        two places for it to be wrong. Hidden entirely for a section with a single page, so
        Overview does not carry a tab strip with one tab in it.
      -->
      <Border x:Name="SubNavHost" Grid.Row="1" Margin="26,0,26,10" Visibility="Collapsed">
        <StackPanel x:Name="SubNav" Orientation="Horizontal" />
      </Border>

      <Grid Grid.Row="2">

        <!-- ================================= DASHBOARD -->
        <ScrollViewer x:Name="ViewDashboard" VerticalScrollBarVisibility="Auto" Padding="26,0,26,18">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <StackPanel>
              </StackPanel>
            </DockPanel>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!--
                hero
                One dark glass panel: what state the machine is in, in one word, with the two
                things you can do about it. White type on indigo - the old version set the headline
                in ink on navy and it vanished.
              -->
              <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26,22">
                <Grid>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeroLabel" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <TextBlock x:Name="HeroState" Style="{StaticResource Display}" FontSize="34" />
                      <Border x:Name="HeroBadge" Width="24" Height="24" CornerRadius="12" Background="{StaticResource Good}"
                              Margin="12,0,0,0" VerticalAlignment="Center">
                        <Path x:Name="HeroBadgeGlyph" Data="{StaticResource IconCheck}" Width="12" Height="12" Stretch="Uniform"
                              Stroke="White" StrokeThickness="2.2" StrokeLineJoin="Round" />
                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="HeroDetail" FontSize="13.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               LineHeight="21" Margin="0,10,0,0" MaxWidth="560" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                      <Button x:Name="HeroFixBtn" Style="{StaticResource PrimaryButton}" Height="36" Click="OnHeroFix" />
                      <Button x:Name="HeroDetailBtn" Style="{StaticResource SecondaryButton}" Height="36" Margin="10,0,0,0"
                              Click="OnHeroDetails" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- health -->
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
                <StackPanel>
                  <TextBlock x:Name="HealthTitle" Style="{StaticResource CardTitle}" />
                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="104" Height="104">
                      <Ellipse Width="96" Height="96" Stroke="#EEF1F7" StrokeThickness="9" />
                      <Ellipse x:Name="HealthRing" Width="96" Height="96" StrokeThickness="9"
                               Stroke="{StaticResource AccentBar}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                               RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                      </Ellipse>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="HealthScoreText" Style="{StaticResource Display}" FontSize="30" HorizontalAlignment="Center" />
                        <TextBlock Text="/100" FontSize="10.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" Margin="0,-5,0,0" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="HealthLabel" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Good}" />
                      <TextBlock x:Name="HealthNote" Style="{StaticResource Tiny}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{StaticResource Hair}" Margin="0,14,0,10" />
                  <ItemsControl x:Name="HealthChecks">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,4">
                          <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="9" Background="{Binding Tone}">
                            <Path Data="{Binding Glyph}" Width="9" Height="9" Stretch="Uniform" Stroke="White" StrokeThickness="1.9" StrokeLineJoin="Round" />
                          </Border>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding State}" FontSize="11.5" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Ink}" Margin="10,0,8,0"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock x:Name="FindingsSect" Style="{StaticResource Sect}" />
            <ItemsControl x:Name="FindingsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,11" Padding="20,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="11" Background="{Binding Tone}" VerticalAlignment="Top">
                        <Path Data="{StaticResource IconSpark}" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{Binding Accent}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                      </Border>
                      <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Benefit}" FontSize="13" Foreground="#33333A" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Safety}" FontSize="13" Foreground="#33333A" TextWrapping="Wrap" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Cost}" Style="{StaticResource Tiny}" Margin="0,5,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                          <Button Content="{Binding FixLabel}" Tag="{Binding OutcomeId}" Visibility="{Binding FixVisible}"
                                  Style="{StaticResource PrimaryButton}" Click="OnFindingFix" />
                          <Border Style="{StaticResource Chip}" Background="{StaticResource Hair}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Evidence}" FontSize="11" Foreground="{StaticResource Muted}" />
                          </Border>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- live strip: four gauges, straight from the machine -->
            <ItemsControl x:Name="DashGauges" Margin="0,0,0,16">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="20,16">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="8" Background="{Binding Tone}">
                          <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="17" Foreground="{Binding Accent}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                      </DockPanel>
                      <TextBlock Grid.Row="1" Text="{Binding Value}" Style="{StaticResource Display}" FontSize="30"
                                 Foreground="{Binding Accent}" Margin="0,10,0,8" />
                      <StackPanel Grid.Row="2">
                        <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding Accent}" />
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Tiny}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.15*" />
              </Grid.ColumnDefinitions>

              <!-- top processes -->
              <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="ProcTitle" Style="{StaticResource CardTitle}" DockPanel.Dock="Left"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock x:Name="ProcHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" TextAlignment="Right" MaxWidth="300" />
                  </DockPanel>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProcColName" Grid.Column="0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" />
                    <TextBlock x:Name="ProcColCpu" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" TextAlignment="Right" />
                    <TextBlock x:Name="ProcColRam" Grid.Column="2" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Faint}" TextAlignment="Right" />
                  </Grid>
                  <TextBlock x:Name="ProcEmpty" Style="{StaticResource Tiny}" Visibility="Collapsed" />
                  <ItemsControl x:Name="ProcList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{Binding RowBg}" CornerRadius="8" Padding="9,6" Margin="0,2">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="70" />
                              <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                              <!-- The program's own icon; the lettered tile only when Windows will not say which program. -->
                              <Grid Width="20" Height="20">
                                <Border CornerRadius="6" Background="{Binding Tone}" Visibility="{Binding LetterVisible}">
                                  <TextBlock Text="{Binding Initial}" FontSize="10" FontWeight="Bold"
                                             Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                              </Grid>
                              <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Ink}"
                                         Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Cpu}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{Binding Accent}" TextAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Ram}" FontSize="12.5" Foreground="{StaticResource Muted}"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- connected devices -->
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="DevTitle" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="DevHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                  </DockPanel>
                  <ItemsControl x:Name="DeviceGroups">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                          <TextBlock Text="{Binding Group}" Style="{StaticResource Sect}" Margin="2,2,0,6" />
                          <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Style="{StaticResource SettingsRow}" Padding="12,9" MinHeight="46">
                                  <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="6" Background="{Binding Tone}" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" Foreground="{Binding Accent}" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                  </DockPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="DevEmpty" Style="{StaticResource Tiny}" Visibility="Collapsed" />
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock x:Name="OutcomesSect" Style="{StaticResource Sect}" Margin="0,6,0,8" />
            <ItemsControl x:Name="OutcomeCards">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource FlatCard}" Width="360" MinHeight="130" Margin="0,0,12,12">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Tiny}" Margin="0,5,0,0" TextWrapping="Wrap" />
                      <Button Content="{Binding OpenLabel}" Tag="{Binding Id}" Style="{StaticResource PrimaryButton}"
                              Height="32" Padding="16,0" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnFindingFix" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= SYSTEM STATUS -->
        <ScrollViewer x:Name="ViewStatus" VerticalScrollBarVisibility="Auto" Padding="26,0,26,18" Visibility="Collapsed">
          <StackPanel>

            <DockPanel Margin="0,4,0,10">
              <ToggleButton x:Name="DetailToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                            Click="OnDetailToggle" />
              <TextBlock x:Name="DetailToggleLabel" DockPanel.Dock="Right" FontSize="12.5" Foreground="{StaticResource Muted}"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock x:Name="ReadingsTitle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="2,0,0,0" />
            </DockPanel>
            <ItemsControl x:Name="ReadingsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SettingsRow}">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="13.5" FontWeight="SemiBold"
                                 Foreground="{Binding Accent}" VerticalAlignment="Center" Margin="16,0,0,0" />
                      <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Background="{Binding Tone}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="17" Foreground="{Binding Accent}" />
                      </Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= PERFORMANCE -->
        <ScrollViewer x:Name="ViewPerf" VerticalScrollBarVisibility="Auto" Padding="26,0,26,18" Visibility="Collapsed">
          <StackPanel>
            <DockPanel Margin="0,0,0,14">
              <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                  <TextBlock x:Name="LiveChip" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="6,0,0,0" />
                </StackPanel>
              </Border>
              <StackPanel>
              </StackPanel>
            </DockPanel>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                  <TextBlock x:Name="CpuChartTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="CpuChartValue" FontSize="34" FontWeight="ExtraBold" Foreground="{StaticResource Accent}" Margin="0,6,0,0" />
                  <Grid Height="150" Margin="0,8,0,0">
                    <Border Background="#F7F9FD" CornerRadius="10" />
                    <Polyline x:Name="CpuChart" Stroke="{StaticResource Accent}" StrokeThickness="2.4" Margin="8" />
                  </Grid>
                  <TextBlock x:Name="CpuChartHint" Style="{StaticResource Tiny}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                  <TextBlock x:Name="RamChartTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="RamChartValue" FontSize="34" FontWeight="ExtraBold" Foreground="{StaticResource Violet}" Margin="0,6,0,0" />
                  <Grid Height="150" Margin="0,8,0,0">
                    <Border Background="#F9F7FD" CornerRadius="10" />
                    <Polyline x:Name="RamChart" Stroke="{StaticResource Violet}" StrokeThickness="2.4" Margin="8" />
                  </Grid>
                  <TextBlock x:Name="RamChartHint" Style="{StaticResource Tiny}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <ItemsControl x:Name="PerfTiles">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                      <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{Binding Accent}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <TextBlock x:Name="PerfProcTitle" Style="{StaticResource CardTitle}" DockPanel.Dock="Left"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                  <TextBlock x:Name="PerfProcHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" TextAlignment="Right" MaxWidth="300" />
                </DockPanel>
                <ItemsControl x:Name="PerfProcList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding RowBg}" CornerRadius="8" Padding="10,7" Margin="0,2">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Grid Width="22" Height="22">
                              <Border CornerRadius="7" Background="{Binding Tone}" Visibility="{Binding LetterVisible}">
                                <TextBlock Text="{Binding Initial}" FontSize="10.5" FontWeight="Bold"
                                           Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform"
                                     RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Ink}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Pid}" FontSize="11" Foreground="{StaticResource Faint}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                          </StackPanel>
                          <ProgressBar Grid.Column="1" Style="{StaticResource ThinBar}" Value="{Binding CpuPercent, Mode=OneWay}"
                                       Foreground="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,14,0" />
                          <TextBlock Grid.Column="2" Text="{Binding Cpu}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" TextAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding Ram}" FontSize="13" Foreground="{StaticResource Muted}"
                                     TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock x:Name="PerfHonestyTitle" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="PerfHonestyBody" Style="{StaticResource Sub}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= PLAN & APPLY -->
        <ScrollViewer x:Name="ViewPlan" VerticalScrollBarVisibility="Auto" Padding="26,0,26,18" Visibility="Collapsed">
          <StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ComboBox x:Name="OutcomeBox" Width="440" DisplayMemberPath="Title" SelectionChanged="OnOutcomeChanged" />
                  <Button x:Name="CompileBtn" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnCompile" />
                </StackPanel>
                <TextBlock x:Name="OutcomeDescription" Style="{StaticResource Sub}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <StackPanel x:Name="PlanResultArea" Visibility="Collapsed">
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock x:Name="PlanCost" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                  <TextBlock x:Name="PlanIrreversible" FontSize="12.5" Foreground="{StaticResource Warn}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  <TextBlock x:Name="PlanBasedOn" Style="{StaticResource Tiny}" Margin="0,6,0,0" />
                  <TextBlock x:Name="PlanHash" Style="{StaticResource Tiny}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>

              <Border x:Name="PlanNotesCard" Style="{StaticResource Card}" Background="{StaticResource WarnSoft}" BorderBrush="#F3DEBB" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="PlanNotesTitle" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Warn}" />
                  <TextBlock x:Name="PlanNotes" FontSize="12.5" Foreground="#5A4632" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
              </Border>

              <ItemsControl x:Name="PhasesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,11">
                      <StackPanel>
                        <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,0,0,7" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{StaticResource RowBg}" CornerRadius="10" Padding="13,10" Margin="0,3">
                                <StackPanel>
                                  <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Change}" FontSize="13" Foreground="#33333A" Margin="0,3,0,0" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Why}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding Meta}" Style="{StaticResource Tiny}" Margin="0,3,0,0" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <CheckBox x:Name="DryRunBox" IsChecked="True" Checked="OnApplyModeChanged" Unchecked="OnApplyModeChanged" />
                  <CheckBox x:Name="RecoveryKeyBox" Margin="0,9,0,0" Checked="OnRecoveryAck" Unchecked="OnRecoveryAck" />
                  <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Height="42" Padding="24,0" Margin="0,14,0,0" Click="OnApply" />
                </StackPanel>
              </Border>
            </StackPanel>

            <Border x:Name="RunResultCard" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="ResultHeading" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="ResultCounts" FontSize="13" Foreground="#33333A" Margin="0,7,0,0" TextWrapping="Wrap" />
                <ItemsControl x:Name="ResultList" Margin="0,9,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource RowBg}" CornerRadius="10" Padding="12,9" Margin="0,3">
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{Binding Tone}">
                            <TextBlock Text="{Binding Symbol}" FontSize="12" FontWeight="Bold" Foreground="{Binding Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Margin="11,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="RestartBanner" Background="{StaticResource WarnSoft}" BorderBrush="#F0DCB4"
                        BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0" Visibility="Collapsed">
                  <DockPanel>
                    <Button x:Name="RestartNowBtn" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Center" Margin="16,0,0,0" Click="OnRestartNow" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="RestartTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                      <TextBlock x:Name="ResultNext" FontSize="12.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <TextBlock x:Name="TxSect" Style="{StaticResource Sect}" Margin="2,20,0,9" />
            <TextBlock x:Name="TxEmpty" Style="{StaticResource Sub}" Margin="0,0,0,12" Visibility="Collapsed" />
            <ItemsControl x:Name="TxList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="{Binding UndoLabel}" Tag="{Binding Id}" Visibility="{Binding UndoVisible}"
                              Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="OnUndoTransaction" />
                      <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="11" Background="{Binding Tone}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconClock}" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Accent}" StrokeThickness="1.6" />
                      </Border>
                      <StackPanel Margin="13,0,12,0">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>

        <!-- ================================= HARDWARE -->
        <ScrollViewer x:Name="ViewHardware" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="VolumesTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="VolumesHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="VolumeList">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding RowBg}" CornerRadius="10" Padding="14,12" Margin="0,3,10,3">
                        <StackPanel>
                          <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Value}" FontSize="12.5" FontWeight="Bold"
                                       Foreground="{Binding Accent}" HorizontalAlignment="Right"
                                       Typography.NumeralAlignment="Tabular" />
                          </DockPanel>
                          <ProgressBar Style="{StaticResource ThinBar}" Height="8" Value="{Binding Percent, Mode=OneWay}"
                                       Foreground="{Binding Accent}" />
                          <TextBlock Text="{Binding Note}" Style="{StaticResource Tiny}" Margin="0,7,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- the inventory, one row per part, grouped the way Settings groups devices -->
            <TextBlock x:Name="InventoryTitle" Style="{StaticResource Sect}" />
            <TextBlock x:Name="InventoryHint" Style="{StaticResource Tiny}" Visibility="Collapsed" />
            <ItemsControl x:Name="InventoryGroups">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding Group}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="2,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource SettingsRow}">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{StaticResource GlyphChevron}" Style="{StaticResource Glyph}"
                                         FontSize="12" Foreground="{StaticResource Faint}" Margin="12,0,0,0" />
                              <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Background="{Binding Tone}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="17" Foreground="{Binding Accent}" />
                              </Border>
                              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= SECURITY -->
        <ScrollViewer x:Name="ViewSecurity" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="SecurityStateTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="SecurityStateHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="SecurityList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{Binding Tone}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{Binding Accent}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="Win11Title" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                <TextBlock x:Name="Win11Body" Style="{StaticResource Sub}" Margin="0,0,0,12" />
                <ItemsControl x:Name="Win11List">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{Binding Tone}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{Binding Accent}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="Win11Plan" Style="{StaticResource SoftButton}" HorizontalAlignment="Left"
                        Margin="0,14,0,0" Click="OnOpenWin11Plan" Visibility="Collapsed" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ================================= RECOVERY -->
        <ScrollViewer x:Name="ViewRecovery" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="RecoveryStateTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="RecoveryStateHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="RecoveryList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{Binding Tone}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{Binding Accent}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="QuarantineTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="QuarantineHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="QuarantineList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{Binding Tone}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{Binding Accent}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ================================= CLEANUP -->
        <!--
          Every row says what the files are, in a sentence a person can judge, and opens to show the
          biggest of them by name. The work itself runs off the UI thread with a progress line and a
          Stop button; the first version awaited synchronous file moves on the dispatcher and froze
          the whole window for the duration.
        -->
        <ScrollViewer x:Name="ViewCleanup" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                  <TextBlock x:Name="CleanupTotalLabel" Style="{StaticResource Sect}" Margin="0,0,0,3" />
                  <TextBlock x:Name="CleanupTotal" Style="{StaticResource BigValue}" />
                  <TextBlock x:Name="CleanupSplit" Style="{StaticResource Tiny}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="CleanupNote" Style="{StaticResource Sub}" VerticalAlignment="Center"
                           Margin="26,0,26,0" TextWrapping="Wrap" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <Button x:Name="CleanupApply" Style="{StaticResource PrimaryButton}" Click="OnCleanupApply" />
                  <Button x:Name="CleanupPurge" Style="{StaticResource DangerButton}" Margin="0,8,0,0" Click="OnCleanupPurge" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- progress: on the page, not over the app -->
            <Border x:Name="CleanupProgressCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
              <DockPanel>
                <Button x:Name="CleanupCancel" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="OnCleanupCancel" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="CleanupProgressText" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                  <ProgressBar x:Name="CleanupProgressBar" Style="{StaticResource ThinBar}" Margin="0,8,0,0"
                               Foreground="{StaticResource AccentBar}" Minimum="0" Maximum="100" />
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="CleanupListTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="CleanupListHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="CleanupList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,12" Background="{Binding RowBg}">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding Chosen, Mode=TwoWay}" IsEnabled="{Binding CanChoose}"
                                      Tag="{Binding Id}" VerticalAlignment="Center" Margin="0,0,12,0" Click="OnCleanupChoice" />

                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="9" Background="{Binding Tint}"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                              <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="16"
                                         Foreground="{Binding Accent}" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                              <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                         Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Explain}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                         TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" />
                              <ProgressBar Style="{StaticResource ThinBar}" Value="{Binding Percent, Mode=OneWay}"
                                           Foreground="{Binding Accent}" Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                              <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="Bold" Foreground="{Binding Accent}"
                                         HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                              <Border Background="{Binding Tint}" CornerRadius="6" Padding="8,2" Margin="0,4,0,0"
                                      HorizontalAlignment="Right">
                                <TextBlock Text="{Binding TrustLabel}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{Binding Accent}" />
                              </Border>
                            </StackPanel>

                            <ToggleButton Grid.Column="4" x:Name="More" Content="{Binding DetailsLabel}"
                                          Style="{StaticResource DetailToggle}" VerticalAlignment="Center"
                                          Visibility="{Binding HasDetails}" />
                          </Grid>

                          <!-- what is actually in there -->
                          <Border Background="#F8FAFC" CornerRadius="9" Padding="14,11" Margin="62,10,0,0"
                                  Visibility="{Binding IsChecked, ElementName=More, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                              <TextBlock Text="{Binding Note}" Style="{StaticResource Tiny}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding LargestLabel}" Style="{StaticResource Sect}" Margin="0,10,0,6" />
                              <ItemsControl ItemsSource="{Binding Largest}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                      <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" FontSize="12" FontWeight="SemiBold"
                                                 Foreground="{StaticResource Ink}" Margin="14,0,0,0"
                                                 Typography.NumeralAlignment="Tabular" />
                                      <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" Style="{StaticResource Tiny}"
                                                 Margin="14,0,0,0" VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Ink}"
                                                 TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Text="{Binding FoldersLabel}" Style="{StaticResource Sect}" Margin="0,10,0,4" />
                              <TextBlock Text="{Binding Folders}" Style="{StaticResource Tiny}" TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ================================= STARTUP -->
        <ScrollViewer x:Name="ViewStartup" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="StartupListTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="StartupListHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="StartupList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="12" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,14,0" />
                          <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                        IsChecked="{Binding IsOn, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                        Tag="{Binding Name}" Click="OnStartupToggled" ToolTip="{Binding Hint}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ================================= DRIVERS -->
        <ScrollViewer x:Name="ViewDrivers" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="DriverProblemTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="DriverProblemHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="DriverProblemList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{Binding Tone}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{Binding Accent}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="DriverAllTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="DriverAllHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="DriverList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{Binding Tone}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{Binding Accent}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ================================= COMPARE -->
        <ScrollViewer x:Name="ViewCompare" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="CompareRun" Style="{StaticResource PrimaryButton}"
                        Click="OnCompareRun" />
                <TextBlock x:Name="CompareWindow" Style="{StaticResource Sub}" VerticalAlignment="Center"
                           Margin="0,0,20,0" />
              </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="CompareChangedTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="CompareChangedHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="CompareChangedList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{Binding Tone}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{Binding Accent}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="CompareVisibilityTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="CompareVisibilityHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="CompareVisibilityList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{Binding Tone}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{Binding Accent}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold"
                                     Foreground="{Binding Accent}" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ================================= TIMELINE -->
        <ScrollViewer x:Name="ViewTimeline" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>
            <Border x:Name="TimelineGapCard" Style="{StaticResource Card}" Margin="0,0,0,14"
                    Background="{StaticResource WarnSoft}" BorderBrush="#F0DCB4" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="TimelineGapTitle" Style="{StaticResource CardTitle}" Foreground="{StaticResource Warn}" />
                <ItemsControl x:Name="TimelineGapList" Margin="0,7,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Style="{StaticResource Tiny}" Foreground="{StaticResource Warn}" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="TimelineListTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="TimelineListHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="TimelineList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,11">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding When}" FontSize="12" Foreground="{StaticResource Faint}"
                                     Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                          <Border Grid.Column="1" Background="{Binding Tone}" CornerRadius="6" Padding="8,2"
                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Accent}" />
                          </Border>
                          <TextBlock Grid.Column="2" Text="{Binding Change}" FontSize="12.5" Foreground="{StaticResource Ink}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ================================= BIOS -->
        <!--
          Everything about the firmware in one place. The settings list was ninety rows deep on the
          first machine that answered, so it is searched, grouped and filtered rather than scrolled:
          a person who wants virtualization for Docker types "virt", or presses the chip that types
          it for them, and sees one row.
        -->
        <ScrollViewer x:Name="ViewBios" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>

            <!-- identity + the two actions, on one card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" VerticalAlignment="Center">
                  <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="12" Background="#E0E7FF"
                          VerticalAlignment="Top">
                    <TextBlock Text="{StaticResource GlyphHardware}" Style="{StaticResource Glyph}"
                               FontSize="20" Foreground="#4338CA" />
                  </Border>
                  <StackPanel Margin="15,0,20,0">
                    <TextBlock x:Name="BiosTitle" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="BiosVersion" Style="{StaticResource BigValue}" FontSize="20" Margin="0,4,0,0" />
                    <TextBlock x:Name="BiosAge" Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Background="{StaticResource RowBg}" CornerRadius="10" Padding="14,11" Width="250" Margin="0,0,10,0">
                    <StackPanel>
                      <TextBlock x:Name="BiosEnterName" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                      <TextBlock x:Name="BiosEnterNote" Style="{StaticResource Tiny}" Margin="0,3,0,8" TextWrapping="Wrap" />
                      <Button x:Name="BiosEnter" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                              Height="32" Padding="14,0" Click="OnEnterFirmware" />
                    </StackPanel>
                  </Border>
                  <Border Background="{StaticResource RowBg}" CornerRadius="10" Padding="14,11" Width="250">
                    <StackPanel>
                      <TextBlock x:Name="BiosVendorName" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                      <TextBlock x:Name="BiosVendorNote" Style="{StaticResource Tiny}" Margin="0,3,0,8" TextWrapping="Wrap" />
                      <Button x:Name="BiosVendor" Style="{StaticResource RowButton}" HorizontalAlignment="Left"
                              Click="OnOpenVendorSupport" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <!-- the settings -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock x:Name="FirmwareVendor" DockPanel.Dock="Right" Style="{StaticResource Tiny}"
                             VerticalAlignment="Center" />
                  <TextBlock x:Name="FirmwareTitle" Style="{StaticResource CardTitle}" />
                </DockPanel>
                <TextBlock x:Name="FirmwareHint" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <Border x:Name="FirmwareUnavailable" Background="{StaticResource RowBg}" CornerRadius="9"
                        Padding="14,12" Visibility="Collapsed">
                  <TextBlock x:Name="FirmwareUnavailableText" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                </Border>

                <StackPanel x:Name="FirmwareTools" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="FirmwareSearch" Style="{StaticResource SearchBox}"
                             TextChanged="OnFirmwareFilterChanged" />
                    <TextBlock Grid.Column="1" x:Name="FirmwareCount" Style="{StaticResource Tiny}"
                               VerticalAlignment="Center" Margin="14,0,4,0" />
                  </Grid>

                  <!-- risk filter -->
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="FwAll" Style="{StaticResource FilterChip}" GroupName="FwRisk" IsChecked="True"
                                 Checked="OnFirmwareFilterChanged" />
                    <RadioButton x:Name="FwRoutine" Style="{StaticResource FilterChip}" GroupName="FwRisk"
                                 Checked="OnFirmwareFilterChanged" />
                    <RadioButton x:Name="FwCareful" Style="{StaticResource FilterChip}" GroupName="FwRisk"
                                 Checked="OnFirmwareFilterChanged" />
                    <RadioButton x:Name="FwSerious" Style="{StaticResource FilterChip}" GroupName="FwRisk"
                                 Checked="OnFirmwareFilterChanged" />
                    <RadioButton x:Name="FwRefused" Style="{StaticResource FilterChip}" GroupName="FwRisk"
                                 Checked="OnFirmwareFilterChanged" />
                  </StackPanel>

                  <!-- the tasks people actually come here for; each one types the search for you -->
                  <TextBlock x:Name="FirmwareQuickLabel" Style="{StaticResource Tiny}" Margin="2,14,0,6" />
                  <WrapPanel x:Name="FirmwareQuick" />

                  <ItemsControl x:Name="FirmwareGroups" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                          <DockPanel Margin="4,0,4,7">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Tiny}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Sect}" />
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Style="{StaticResource SettingsRow}" Padding="13,9" Background="{Binding RowBg}">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,14,0">
                                      <Ellipse Style="{StaticResource RiskDot}" Fill="{Binding RiskInk}"
                                               ToolTip="{Binding RiskLabel}" />
                                      <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                 Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{Binding RiskTint}" CornerRadius="6"
                                            Padding="8,2" VerticalAlignment="Center" Margin="0,0,12,0">
                                      <TextBlock Text="{Binding Current}" FontSize="11.5" FontWeight="SemiBold"
                                                 Foreground="{Binding RiskInk}" />
                                    </Border>

                                    <ComboBox Grid.Column="2" Width="150" Height="30" VerticalAlignment="Center"
                                              ItemsSource="{Binding Options}" SelectedItem="{Binding Wanted, Mode=TwoWay}"
                                              IsEnabled="{Binding Writable}" />

                                    <Button Grid.Column="3" Content="{Binding ApplyLabel}" Tag="{Binding Name}"
                                            Margin="8,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding Writable}"
                                            Style="{StaticResource RowButton}" Click="OnFirmwareApply" />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock x:Name="FirmwareNoMatch" Style="{StaticResource Sub}" Margin="4,6,0,0"
                             Visibility="Collapsed" />
                </StackPanel>

                <Border Background="#FEF3C7" CornerRadius="9" Padding="13,11" Margin="0,12,0,0">
                  <TextBlock x:Name="BiosWriteNote" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>

            <!-- what the firmware reports about itself -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,10">
                  <TextBlock x:Name="BiosStateTitle" Style="{StaticResource CardTitle}" />
                  <TextBlock x:Name="BiosStateHint" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
                </DockPanel>
                <ItemsControl x:Name="BiosList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="14,10" Background="{Binding RowBg}">
                        <DockPanel>
                          <Border DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="8"
                                  Background="{Binding Tone}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15"
                                       Foreground="{Binding Accent}" />
                          </Border>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontSize="13.5"
                                     FontWeight="SemiBold" Foreground="{Binding Accent}"
                                     VerticalAlignment="Center" Margin="16,0,0,0" />
                          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}" Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- for going in by hand -->
            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <TextBlock x:Name="GuideTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                <TextBlock x:Name="GuideHint" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <ItemsControl x:Name="GuideList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="16,14" Background="{Binding RowBg}" Margin="0,0,0,8">
                        <StackPanel>
                          <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource RowBg}" CornerRadius="6"
                                    Padding="8,3" Margin="10,0,0,0">
                              <TextBlock Text="{Binding Tier}" FontSize="10.5" FontWeight="SemiBold"
                                         Foreground="{StaticResource Muted}" />
                            </Border>
                            <TextBlock Text="{Binding Goal}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}" VerticalAlignment="Center" TextWrapping="Wrap" />
                          </DockPanel>
                          <Border Background="#EEF2FF" CornerRadius="8" Padding="12,9" Margin="0,10,0,0">
                            <StackPanel>
                              <TextBlock Text="{Binding SettingLabel}" Style="{StaticResource Tiny}" />
                              <TextBlock Text="{Binding SettingName}" FontSize="15" FontWeight="SemiBold"
                                         Foreground="#3730A3" Margin="0,2,0,0" />
                              <TextBlock Text="{Binding AlsoCalled}" Style="{StaticResource Tiny}" Margin="0,4,0,0"
                                         TextWrapping="Wrap" Visibility="{Binding AlsoCalledVisible}" />
                            </StackPanel>
                          </Border>
                          <TextBlock Text="{Binding Steps}" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                     Foreground="{StaticResource Ink}" />
                          <TextBlock Text="{Binding Note}" Style="{StaticResource Tiny}" Margin="0,8,0,0"
                                     TextWrapping="Wrap" Visibility="{Binding NoteVisible}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ================================= APP CATALOGUE -->
        <!--
          A store, not a list. Cards in a grid with the product's real icon, a tick on each, and one
          button that installs everything ticked — several at a time. The catalogue is still the
          allowlist: nothing here searches the wider repository, and "Reinstall from list" installs
          only what is in this catalogue whatever the file says.
        -->
        <ScrollViewer x:Name="ViewApps" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" x:Name="AppsSearch" Style="{StaticResource SearchBox}"
                           TextChanged="OnAppsSearchChanged" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="AppsInstallSelected" Style="{StaticResource PrimaryButton}" Height="38"
                            Padding="16,0" Click="OnInstallSelected" />
                    <Button x:Name="AppsRemoveSelected" Style="{StaticResource DangerButton}" Height="38"
                            Padding="14,0" Margin="8,0,0,0" Click="OnRemoveSelected" />
                  </StackPanel>
                </Grid>

                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="AppsSelectMissing" Style="{StaticResource QuickChip}" Click="OnSelectMissing" />
                  <Button x:Name="AppsSelectAll" Style="{StaticResource QuickChip}" Click="OnSelectAllApps" />
                  <Button x:Name="AppsClear" Style="{StaticResource QuickChip}" Click="OnClearSelection" />
                  <Border Width="1" Height="18" Background="{StaticResource Hair}" Margin="4,0,10,6" VerticalAlignment="Center" />
                  <Button x:Name="AppsBackup" Style="{StaticResource QuickChip}" Click="OnBackupApps" />
                  <Button x:Name="AppsRestore" Style="{StaticResource QuickChip}" Click="OnRestoreApps" />
                </WrapPanel>

                <TextBlock x:Name="AppsHint" Style="{StaticResource Tiny}" TextWrapping="Wrap" Margin="2,4,0,0" />
                <TextBlock x:Name="AppsProblem" Style="{StaticResource Tiny}" Margin="2,7,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Warn}" Visibility="Collapsed" />
              </StackPanel>
            </Border>

            <ItemsControl x:Name="AppGroups">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,10">
                    <DockPanel Margin="4,0,4,8">
                      <Button DockPanel.Dock="Right" Content="{Binding SelectLabel}" Tag="{Binding Key}"
                              Style="{StaticResource QuickChip}" Margin="0" Click="OnSelectGroup" />
                      <TextBlock Text="{Binding Count}" Style="{StaticResource Tiny}" DockPanel.Dock="Right"
                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Sect}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Apps}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource AppCard}">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>

                              <DockPanel Grid.Row="0">
                                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Top"
                                          IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                                          Click="OnAppSelectionChanged" />
                                <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                  <Border CornerRadius="10" Background="{Binding Tile}" Visibility="{Binding GlyphVisible}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="18"
                                               Foreground="{Binding Accent}" />
                                  </Border>
                                  <Image Source="{Binding Icon}" Width="34" Height="34" Stretch="Uniform"
                                         RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                              </DockPanel>

                              <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                         Foreground="{StaticResource Ink}" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Row="2" Text="{Binding Publisher}" Style="{StaticResource Tiny}" Margin="0,1,0,0"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Row="3" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Muted}"
                                         Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />

                              <DockPanel Grid.Row="4" Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Tag="{Binding Id}"
                                        IsEnabled="{Binding CanAct}" Style="{StaticResource RowButton}"
                                        Click="OnAppAction" />
                                <TextBlock Text="{Binding State}" FontSize="11.5" Foreground="{Binding Tone}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </DockPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="AppsNoMatch" Style="{StaticResource Sub}" Margin="4,6,0,0" Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= OFFICE -->
        <ScrollViewer x:Name="ViewOffice" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock x:Name="OfficeStateTitle" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="OfficeStateValue" Style="{StaticResource BigValue}" Margin="0,6,0,0" />
                <TextBlock x:Name="OfficeStateNote" Style="{StaticResource Sub}" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock x:Name="OfficePlanTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                <TextBlock x:Name="OfficePlanHint" Style="{StaticResource Sub}" TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock x:Name="OfficeProductLabel" Style="{StaticResource Tiny}" Margin="2,0,0,5" />
                <ComboBox x:Name="OfficeProductBox" Width="330" HorizontalAlignment="Left" Height="34"
                          SelectionChanged="OnOfficePlanChanged" />

                <TextBlock x:Name="OfficeLanguageLabel" Style="{StaticResource Tiny}" Margin="2,14,0,5" />
                <ComboBox x:Name="OfficeLanguage" Width="330" HorizontalAlignment="Left" Height="34"
                          SelectionChanged="OnOfficePlanChanged" />

                <TextBlock x:Name="OfficeExcludeLabel" Style="{StaticResource Tiny}" Margin="2,16,0,6" />
                <ItemsControl x:Name="OfficeExclude">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>

                <Border Background="{StaticResource RowBg}" CornerRadius="9" Padding="13,11" Margin="0,16,0,0">
                  <TextBlock x:Name="OfficeSummary" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                </Border>

                <DockPanel Margin="0,14,0,0">
                  <Button x:Name="OfficeInstall" Style="{StaticResource PrimaryButton}"
                          HorizontalAlignment="Left" Click="OnOfficeInstall" />
                  <TextBlock x:Name="OfficeProgress" Style="{StaticResource Sub}" VerticalAlignment="Center"
                             Margin="14,0,0,0" TextWrapping="Wrap" />
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ================================= WINDOWS ITSELF -->
        <ScrollViewer x:Name="ViewWindows" VerticalScrollBarVisibility="Auto" Padding="30,0,30,20" Visibility="Collapsed">
          <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock x:Name="LicenceTitle" Style="{StaticResource CardTitle}" />
                <TextBlock x:Name="LicenceStateValue" Style="{StaticResource BigValue}" Margin="0,6,0,0" />
                <TextBlock x:Name="LicenceNote" Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock x:Name="EditionTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                <TextBlock x:Name="EditionHint" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock x:Name="EditionCurrent" Style="{StaticResource Metric}" FontWeight="SemiBold" />

                <ItemsControl x:Name="EditionTargets" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource SettingsRow}" Padding="13,11" Background="{Binding RowBg}">
                        <DockPanel>
                          <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Ink}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Tiny}"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#FEF3C7" CornerRadius="9" Padding="13,11" Margin="0,12,0,0">
                  <TextBlock x:Name="EditionKeyNote" Style="{StaticResource Sub}" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
              <StackPanel>
                <TextBlock x:Name="ReinstallTitle" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                <TextBlock x:Name="ReinstallHint" Style="{StaticResource Sub}" TextWrapping="Wrap" Margin="0,0,0,12" />

                <DockPanel>
                  <Button x:Name="ReinstallPick" Style="{StaticResource SecondaryButton}"
                          HorizontalAlignment="Left" Click="OnPickIso" />
                  <TextBlock x:Name="ReinstallFile" Style="{StaticResource Sub}" VerticalAlignment="Center"
                             Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <StackPanel x:Name="ReinstallDetail" Margin="0,14,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="ReinstallMedia" Style="{StaticResource Metric}" FontWeight="SemiBold" />

                  <TextBlock x:Name="ReinstallScopeLabel" Style="{StaticResource Tiny}" Margin="2,14,0,5" />
                  <ComboBox x:Name="ReinstallScopeBox" Width="330" HorizontalAlignment="Left" Height="34"
                            SelectionChanged="OnReinstallScopeChanged" />

                  <ItemsControl x:Name="ReinstallChecks" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SettingsRow}" Padding="13,11" Background="{Binding RowBg}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Style="{StaticResource Glyph}"
                                       FontSize="15" Foreground="{Binding Tone}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource Ink}"
                                       Margin="11,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button x:Name="ReinstallStartBtn" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                          HorizontalAlignment="Left" Click="OnReinstallStart" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!--
          Page busy. A thin bar under the header rather than a modal veil: the page's own headings
          stay readable, so it reads as "filling in" instead of "blocked".
        -->
        <Border x:Name="PageBusy" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Height="3" Margin="30,0" Background="#E6E6EE" CornerRadius="2" IsHitTestVisible="False">
          <Border x:Name="PageBusyBar" Width="180" HorizontalAlignment="Left" CornerRadius="2"
                  Background="{StaticResource AccentBar}">
            <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
          </Border>
          <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="PageBusyBar"
                                   Storyboard.TargetProperty="RenderTransform.X"
                                   From="-200" To="1500" Duration="0:0:1.1" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Border.Triggers>
        </Border>

        <!-- busy overlay -->
        <Border x:Name="BusyOverlay" Background="#88EAF1FB" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,22">
            <StackPanel Orientation="Horizontal">
              <ProgressBar IsIndeterminate="True" Width="140" Height="6" VerticalAlignment="Center" />
              <TextBlock x:Name="BusyText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Border>
      </Grid>
      </Grid>
    </Grid>

  </Grid>
</Window>
