<Window x:Class="PcOrbit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="880" Width="1380" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{StaticResource PageBg}"
        Loaded="OnLoaded" Closed="OnClosed">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ================================================================ sidebar -->
    <Border Grid.Column="0" Background="#8CFFFFFF" BorderBrush="#FFFFFF" BorderThickness="0,0,1,0" Padding="16,20,16,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
          <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource LogoBg}">
            <Path Data="M20,9 L31,15.5 31,24.5 20,31 9,24.5 9,15.5 Z" Fill="#EBF3FF" Stretch="Uniform" Margin="9" />
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="AppTitle" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" />
            <TextBlock x:Name="AppTagline" FontSize="11" Foreground="{StaticResource Faint}" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="NavStatus" Style="{StaticResource NavItem}" IsChecked="True" Checked="OnNavChanged" />
          <RadioButton x:Name="NavPlan" Style="{StaticResource NavItem}" Checked="OnNavChanged" />
          <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Checked="OnNavChanged" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
              <TextBlock x:Name="MachineName" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
              <TextBlock x:Name="MachineOs" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,3,0,0" TextWrapping="Wrap" />
              <TextBlock x:Name="MachineTier" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="6,12,0,0">
            <Button x:Name="LangVi" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" Content="VI" Click="OnLangVi" />
            <Button x:Name="LangEn" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" Content="EN" Margin="8,0,0,0" Click="OnLangEn" />
          </StackPanel>
        </StackPanel>

        <Border />
      </DockPanel>
    </Border>

    <!-- ================================================================ content -->
    <Grid Grid.Column="1">

      <!-- ============================================== status view -->
      <ScrollViewer x:Name="PanelStatus" VerticalScrollBarVisibility="Auto" Padding="26,20,26,20">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <Button x:Name="RescanBtn" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Click="OnRescan" />
            <StackPanel>
              <TextBlock x:Name="StatusTitle" Style="{StaticResource H1}" />
              <TextBlock x:Name="StatusSub" Style="{StaticResource Sub}" Margin="0,4,20,0" />
            </StackPanel>
          </DockPanel>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,18">
            <StackPanel>
              <TextBlock x:Name="HeroState" FontSize="26" FontWeight="ExtraBold" Foreground="{StaticResource Ink}" />
              <TextBlock x:Name="HeroDetail" Style="{StaticResource Sub}" Margin="0,6,0,0" />
            </StackPanel>
          </Border>

          <ItemsControl x:Name="FindingsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,16">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Benefit}" FontSize="13" Foreground="#33333A" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Safety}" FontSize="13" Foreground="#33333A" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding Cost}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,4,0,0" />
                    <Button Content="{Binding FixLabel}" Tag="{Binding OutcomeId}" Visibility="{Binding FixVisible}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnFindingFix" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="ReadingsTitle" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,8" />
              <ItemsControl x:Name="ReadingsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Ink}" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                      <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11.5" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ============================================== plan view -->
      <ScrollViewer x:Name="PanelPlan" VerticalScrollBarVisibility="Auto" Padding="26,20,26,20" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="PlanTitle" Style="{StaticResource H1}" />
          <TextBlock x:Name="PlanSub" Style="{StaticResource Sub}" Margin="0,4,0,14" />

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="OutcomeBox" Width="420" Height="34" FontSize="13" VerticalContentAlignment="Center" DisplayMemberPath="Title" />
                <Button x:Name="CompileBtn" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnCompile" />
              </StackPanel>
              <TextBlock x:Name="OutcomeDescription" Style="{StaticResource Sub}" Margin="0,8,0,0" />
            </StackPanel>
          </Border>

          <StackPanel x:Name="PlanResultArea" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock x:Name="PlanCost" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                <TextBlock x:Name="PlanNotes" FontSize="12" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock x:Name="PlanHash" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>

            <ItemsControl x:Name="PhasesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                      <TextBlock Text="{Binding Header}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Faint}" Margin="0,0,0,6" />
                      <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="0,6">
                              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Change}" FontSize="12.5" Foreground="#33333A" Margin="0,2,0,0" />
                              <TextBlock Text="{Binding Why}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Meta}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,2,0,0" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <CheckBox x:Name="DryRunBox" FontSize="13" Foreground="{StaticResource Ink}" IsChecked="True" />
                <CheckBox x:Name="RecoveryKeyBox" FontSize="13" Foreground="{StaticResource Ink}" Margin="0,8,0,0" Checked="OnRecoveryAck" Unchecked="OnRecoveryAck" />
                <Button x:Name="ApplyBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Height="40" Click="OnApply" />
              </StackPanel>
            </Border>
          </StackPanel>

          <Border x:Name="RunResultCard" Style="{StaticResource Card}" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="ResultHeading" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" />
              <TextBlock x:Name="ResultCounts" FontSize="13" Foreground="#33333A" Margin="0,6,0,0" />
              <ItemsControl x:Name="ResultList" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,4">
                      <TextBlock FontSize="13" Foreground="{StaticResource Ink}">
                        <Run Text="{Binding Symbol, Mode=OneWay}" FontWeight="Bold" /> <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                      </TextBlock>
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="16,1,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="ResultNext" FontSize="12.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ============================================== history view -->
      <ScrollViewer x:Name="PanelHistory" VerticalScrollBarVisibility="Auto" Padding="26,20,26,20" Visibility="Collapsed">
        <StackPanel>
          <DockPanel Margin="0,0,0,14">
            <Button x:Name="HistoryRefreshBtn" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top" Click="OnHistoryRefresh" />
            <StackPanel>
              <TextBlock x:Name="HistoryTitle" Style="{StaticResource H1}" />
              <TextBlock x:Name="HistorySub" Style="{StaticResource Sub}" Margin="0,4,20,0" />
            </StackPanel>
          </DockPanel>

          <ItemsControl x:Name="TxList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                  <DockPanel>
                    <Button Content="{Binding UndoLabel}" Tag="{Binding Id}" Visibility="{Binding UndoVisible}" DockPanel.Dock="Right"
                            Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Click="OnUndoTransaction" />
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource Card}" Margin="0,4,0,0">
            <StackPanel>
              <TextBlock x:Name="EventsTitle" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="0,0,0,8" />
              <ItemsControl x:Name="EventsList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding When}" FontSize="12" Foreground="{StaticResource Faint}" />
                      <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="12" Foreground="{StaticResource Muted}" />
                      <TextBlock Grid.Column="2" Text="{Binding Change}" FontSize="12.5" Foreground="{StaticResource Ink}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- busy overlay -->
      <Border x:Name="BusyOverlay" Background="#66EAF1FB" Visibility="Collapsed">
        <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30,20">
          <StackPanel Orientation="Horizontal">
            <ProgressBar IsIndeterminate="True" Width="130" Height="6" VerticalAlignment="Center" />
            <TextBlock x:Name="BusyText" FontSize="13.5" Foreground="{StaticResource Ink}" Margin="14,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Border>

    </Grid>
  </Grid>
</Window>
