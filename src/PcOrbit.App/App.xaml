    <Geometry x:Key="IconGrid">M 3,3 L 9,3 L 9,9 L 3,9 Z M 11,3 L 17,3 L 17,9 L 11,9 Z M 3,11 L 9,11 L 9,17 L 3,17 Z M 11,11 L 17,11 L 17,17 L 11,17 Z</Geometry>
    <Geometry x:Key="IconAuto">M 4,7 A 6,6 0 0 1 15,5 M 16,13 A 6,6 0 0 1 5,15 M 15,2 L 15,5 L 12,5 M 5,18 L 5,15 L 8,15</Geometry>
    <Geometry x:Key="IconBackup">M 3,4 L 17,4 L 17,9 L 3,9 Z M 3,11 L 17,11 L 17,16 L 3,16 Z</Geometry>
    <Geometry x:Key="IconClock">M 3,10 A 7,7 0 1 1 17,10 A 7,7 0 1 1 3,10 M 10,6 L 10,10 L 12.6,12</Geometry>
    <Geometry x:Key="IconTools">M 12.5,6.5 L 4.5,14.5 L 3,17 L 5.5,15.5 L 13.5,7.5 M 11,4 L 14,2.5 L 17,5 L 15.5,8</Geometry>
    <Geometry x:Key="IconShield">M 10,2.5 L 16.5,5 L 16.5,10 C 16.5,13.8 13.7,16.6 10,17.5 C 6.3,16.6 3.5,13.8 3.5,10 L 3.5,5 Z M 7.2,10 L 9.2,12 L 12.8,8</Geometry>
    <Geometry x:Key="IconCheck">M 4.5,8.5 L 8,12 L 15,4.5</Geometry>
    <Geometry x:Key="IconMonitor">M 3,4 L 17,4 L 17,14 L 3,14 Z M 7,17 L 13,17 M 10,14 L 10,17</Geometry>
    <Geometry x:Key="IconRam">M 3,7 L 17,7 L 17,14 L 3,14 Z M 6,7 L 6,5 M 10,7 L 10,5 M 14,7 L 14,5</Geometry>
    <Geometry x:Key="IconDisk">M 4,3 L 16,3 L 16,17 L 4,17 Z M 7,6.5 L 13,6.5 M 7,9.5 L 13,9.5</Geometry>
    <Geometry x:Key="IconWifi">M 6.5,11.5 A 5,5 0 0 1 13.5,11.5 M 4,8.5 A 8.5,8.5 0 0 1 16,8.5</Geometry>
    <Geometry x:Key="IconBattery">M 2.5,6.5 L 14.5,6.5 L 14.5,13.5 L 2.5,13.5 Z M 15,8.5 L 17,8.5 L 17,11.5 L 15,11.5</Geometry>
    <Geometry x:Key="IconSearch">M 3.5,9 A 5.5,5.5 0 1 1 14.5,9 A 5.5,5.5 0 1 1 3.5,9 M 13.5,13.5 L 17,17</Geometry>
    <Geometry x:Key="IconArrow">M 2.5,7 L 11.5,7 M 8,3.5 L 11.5,7 L 8,10.5</Geometry>
    <Geometry x:Key="IconBell">M 4,14 L 4,9 A 6,6 0 0 1 16,9 L 16,14 L 17.5,16 L 2.5,16 Z M 8.5,18 A 1.8,1.8 0 0 0 11.5,18</Geometry>
    <Geometry x:Key="IconMoon">M 16.5,12 A 7,7 0 0 1 8,3.5 A 7,7 0 1 0 16.5,12</Geometry>
    <Geometry x:Key="IconCog">M 10,7.4 A 2.6,2.6 0 1 1 10,12.6 A 2.6,2.6 0 1 1 10,7.4 M 10,3 L 10,5 M 10,15 L 10,17 M 3,10 L 5,10 M 15,10 L 17,10 M 5.2,5.2 L 6.6,6.6 M 13.4,13.4 L 14.8,14.8 M 14.8,5.2 L 13.4,6.6 M 6.6,13.4 L 5.2,14.8</Geometry>

    <!-- window caption. Geometry, not strings: TemplateBinding does not convert types. -->
    <sys:String x:Key="IconMinimize">&#xE921;</sys:String>
    <sys:String x:Key="IconMaximize">&#xE922;</sys:String>
    <sys:String x:Key="IconClose">&#xE8BB;</sys:String>

    <!-- new pages -->
    <Geometry x:Key="IconBroom">M 12,2 L 15,5 L 8.5,11.5 L 5.5,8.5 Z M 5.5,8.5 L 2.5,15.5 L 9.5,12.5 M 4,12 L 6,14</Geometry>
    <Geometry x:Key="IconPower">M 10,3 L 10,9.5 M 5.6,5.6 A 6.2,6.2 0 1 0 14.4,5.6</Geometry>
    <Geometry x:Key="IconLifebuoy">M 10,3 A 7,7 0 1 1 10,17 A 7,7 0 1 1 10,3 M 10,6.6 A 3.4,3.4 0 1 1 10,13.4 A 3.4,3.4 0 1 1 10,6.6 M 5,5 L 7.6,7.6 M 12.4,12.4 L 15,15 M 15,5 L 12.4,7.6 M 7.6,12.4 L 5,15</Geometry>
    <Geometry x:Key="IconCompare">M 4,5 L 9,5 M 4,10 L 9,10 M 4,15 L 9,15 M 11,5 L 16,5 M 11,10 L 16,10 M 11,15 L 16,15</Geometry>
    <Geometry x:Key="IconLock">M 5.5,9 L 14.5,9 L 14.5,16.5 L 5.5,16.5 Z M 7.5,9 L 7.5,6.5 A 2.5,2.5 0 0 1 12.5,6.5 L 12.5,9</Geometry>

    <!-- ============================================================ elevation -->
    <!--
      Two shadows, not one. A tight dark shadow gives the edge its contact with the page and a
      wide soft one gives the card its height; a single blur does one or the other and reads flat.
      WPF allows one Effect per element, so the tight layer is a hairline border in the same hue.
    -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E3E5EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="20,16" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
      The Settings row: one thing per line, an icon on the left, a name with a one-line description,
      and whatever there is to say about it on the right. Windows uses it for every setting on every
      page, which is why a person already knows how to read it.
    -->
    <Style x:Key="SettingsRow" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#E3E5EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,13" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="MinHeight" Value="60" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value><TranslateTransform /></Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-1"
                               Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0"
                               Duration="0:0:0.16" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FBFBFD" />
          <Setter Property="BorderBrush" Value="#C9CCE8" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="FlatCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="15,13" />
    </Style>

    <!-- A card that carries no shadow, for dense lists where 20 shadows become a grey smear. -->
    <Style x:Key="PlainCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Effect" Value="{x:Null}" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- ============================================================ text -->
    <!--
      A real scale rather than a handful of sizes: 28 / 19 / 15 / 13 / 11.5, each with a weight and
      a colour that says what it is. Large text is tracked slightly tighter, which is the single
      cheapest thing that separates a considered interface from a default one.
    -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="19" />
    </Style>

    <!-- Section label: small, spaced, upper-ish. It orders the page without shouting. -->
    <Style x:Key="Sect" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="Margin" Value="2,4,0,10" />
      <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="Tiny" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
      Numbers get lining, tabular figures. Without this a column of readings jitters as the digits
      change width, which is exactly the sort of small wrongness that makes a dashboard feel cheap.
    -->
    <Style x:Key="Display" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="FontSize" Value="34" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="BigValue" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Metric" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ============================================================ nav -->
    <!--
      On the dark rail the active item is a filled indigo block rather than a tinted one: at this
      value there is no such thing as a subtle tint, and a barely-there highlight would leave the
      user unsure which page they are on.
    -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource SideInk}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Bg" CornerRadius="9" Padding="13,0" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="Ico" Text="{TemplateBinding Tag}" Style="{StaticResource Glyph}"
                             FontSize="16" Foreground="{TemplateBinding BorderBrush}" Width="20" />
                  <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- The marker rail. Reads as position even for someone who cannot see the fill. -->
              <Border x:Name="Marker" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                      Background="{StaticResource Accent}" Visibility="Collapsed" Margin="-9,0,0,0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource NavActive}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Bg" Property="Background" Value="#EDEDF3" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Pivot tab: the second level of navigation.

      The rail now carries five destinations instead of twelve, and the pages that used to sit
      beside each other in it sit inside one of them. That is the whole point of the change — the
      rail answers "which part of my PC", and the pivot answers "which view of it" — so the pivot
      has to read as a level below the rail, not as a second rail. Hence an underline rather than a
      filled block: it marks a position without competing with the item that is lit on the left.
    -->
    <Style x:Key="PivotTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Bg" CornerRadius="8" Padding="13,0" Background="Transparent">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>

              <!--
                The underline animates its width rather than appearing at full size. It is the one
                piece of motion on the page and it exists to carry the eye from the old tab to the
                new one, which is the difference between a page that switched and a page that
                flickered.
              -->
              <Border x:Name="Rule" Height="2.5" CornerRadius="2" VerticalAlignment="Bottom"
                      HorizontalAlignment="Center" Width="0" Background="{StaticResource AccentBar}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Rule" Storyboard.TargetProperty="Width"
                                       To="22" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Rule" Storyboard.TargetProperty="Width"
                                       To="0" Duration="0:0:0.12" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Bg" Property="Background" Value="#F0F1F6" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Group heading inside the rail, so fourteen destinations read as four groups. -->
    <Style x:Key="NavGroup" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#7A8090" />
      <Setter Property="Margin" Value="14,18,0,6" />
    </Style>

    <!-- ============================================================ buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentDeep}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#312E81" />
                <Setter TargetName="Bg" Property="RenderTransform">
                  <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value>
                </Setter>
                <Setter TargetName="Bg" Property="RenderTransformOrigin" Value="0.5,0.5" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bg" Property="Background" Value="#C7CBF0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A button on a pale background needs an edge, or it reads as a label. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource White}" />
      <Setter Property="Foreground" Value="#1E293B" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="#D7DEE8" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#F8FAFC" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource AccentDeep}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#A3AEBE" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Hair}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="Foreground" Value="{StaticResource AccentDeep}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="#C7CBF5" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#A3AEBE" />
                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Hair}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A small button that lives inside a list row. -->
    <!--
      For an action that cannot be undone. Outlined in the warning colour rather than filled with
      it: filled reads as "press me", and this one should read as "read the label first". Loud
      enough to be found, quiet enough not to be the default.
    -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Foreground" Value="{StaticResource Bad}" />
      <Setter Property="BorderBrush" Value="{StaticResource Bad}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Height" Value="30" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="13,0" />
    </Style>

    <!-- window caption buttons, on the light top bar -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#1B1B1F" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
              <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Glyph}" FontSize="10"
                         Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#E9EDF3" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundIcon" TargetType="Border">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
    </Style>

    <!-- pill / chip -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="ThinBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{StaticResource AccentBar}" />
      <Setter Property="Background" Value="#EDF1F6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border CornerRadius="3" Background="{TemplateBinding Background}">
              <Border x:Name="PART_Track" CornerRadius="3">
                <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}"
                        HorizontalAlignment="Left" />
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A switch, for the one page that has per-row on/off. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Track" CornerRadius="11" Background="#CBD5E1">
              <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left"
                       Margin="3,0,0,0" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Background" Value="#E9EDF3" />
                <Setter TargetName="Knob" Property="Fill" Value="#CBD5E1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#C3CDDB" CornerRadius="3" Width="6" HorizontalAlignment="Center" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="38" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource White}" />
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource Ink}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                    MaxWidth="360">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================================================ search, filters, cards -->
    <!--
      A search field that looks like the one in Settings: a rounded well with the magnifier
      inside it, and the accent border only while it has focus. Placeholder text is a Tag the
      template shows while the box is empty, so the page never needs a second TextBlock for it.
    -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Background" Value="{StaticResource White}" />
      <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="38,0,12,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Well" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <Grid>
                <TextBlock Text="{StaticResource GlyphSearch}" Style="{StaticResource Glyph}" FontSize="15"
                           Foreground="{StaticResource Faint}" HorizontalAlignment="Left" Margin="13,0,0,0" />
                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" FontSize="13.5"
                           Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                           Margin="38,0,12,0" IsHitTestVisible="False" Visibility="Collapsed" />
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      A filter chip. Radio semantics, because a filter is one-of; drawn as a pill so a row of them
      reads as choices rather than as buttons that do things.
    -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" CornerRadius="15" Padding="12,0" Background="{StaticResource White}"
                    BorderBrush="{StaticResource Hair}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsChecked" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Bg" Property="Background" Value="#F0F1F6" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A quick-search chip: pressing it types for you. Same pill, button semantics. -->
    <Style x:Key="QuickChip" TargetType="Button" BasedOn="{StaticResource RowButton}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="11,0" />
    </Style>

    <!--
      A catalogue card. Fixed width so a WrapPanel lays them in a clean grid; the lift on hover is
      the same storyboard the rest of the app uses, so cards feel like the rows they replaced.
    -->
    <Style x:Key="AppCard" TargetType="Border">
      <Setter Property="Width" Value="236" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="Padding" Value="14,13,14,12" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{StaticResource White}" />
      <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value><TranslateTransform /></Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#C7CDDC" />
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-2" Duration="0:0:0.12" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.12" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A small circular risk marker beside a setting's name. -->
    <Style x:Key="RiskDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

  </Application.Resources>
</Application>
