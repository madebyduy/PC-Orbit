<Application x:Class="PcOrbit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- ============================================================ palette -->
    <SolidColorBrush x:Key="Ink" Color="#1E2B3C" />
    <SolidColorBrush x:Key="Muted" Color="#6B7A8F" />
    <SolidColorBrush x:Key="Faint" Color="#8A99AD" />
    <SolidColorBrush x:Key="Hair" Color="#EEF2F8" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EAF2FF" />
    <SolidColorBrush x:Key="Good" Color="#0F9D6E" />
    <SolidColorBrush x:Key="GoodSoft" Color="#E3F8EF" />
    <SolidColorBrush x:Key="Warn" Color="#B45309" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FDF3E7" />
    <SolidColorBrush x:Key="Bad" Color="#C42B1C" />
    <SolidColorBrush x:Key="Violet" Color="#8B5CF6" />
    <SolidColorBrush x:Key="VioletSoft" Color="#F0EAFF" />
    <SolidColorBrush x:Key="Cyan" Color="#06B6D4" />
    <SolidColorBrush x:Key="CyanSoft" Color="#E2F6FD" />
    <SolidColorBrush x:Key="Orange" Color="#F97316" />
    <SolidColorBrush x:Key="OrangeSoft" Color="#FFEFE6" />
    <SolidColorBrush x:Key="CardBg" Color="#F0FFFFFF" />
    <SolidColorBrush x:Key="SideBg" Color="#8AFFFFFF" />
    <SolidColorBrush x:Key="White" Color="#FFFFFF" />

    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#EAF1FB" Offset="0" />
      <GradientStop Color="#E7EFFA" Offset="0.45" />
      <GradientStop Color="#E9F2F6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#60A5FA" Offset="0" />
      <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBg" StartPoint="0,0" EndPoint="1,0.6">
      <GradientStop Color="#F3E8FF" Offset="0" />
      <GradientStop Color="#E9EDFF" Offset="0.5" />
      <GradientStop Color="#FDEEF5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#60A5FA" Offset="0" />
      <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="VioletBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#A78BFA" Offset="0" />
      <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrangeBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FDBA74" Offset="0" />
      <GradientStop Color="#F97316" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoodBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#6EE7B7" Offset="0" />
      <GradientStop Color="#10B981" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================ icons -->
    <Geometry x:Key="IconHome">M 3,9 L 10,3 L 17,9 L 17,17 L 3,17 Z</Geometry>
    <Geometry x:Key="IconGauge">M 3,10 A 7,7 0 1 1 17,10 M 10,10 L 13.5,6.5</Geometry>
    <Geometry x:Key="IconChip">M 5,5 L 15,5 L 15,15 L 5,15 Z M 8,2 L 8,5 M 12,2 L 12,5 M 8,15 L 8,18 M 12,15 L 12,18 M 2,8 L 5,8 M 2,12 L 5,12 M 15,8 L 18,8 M 15,12 L 18,12</Geometry>
    <Geometry x:Key="IconSpark">M 11,2 L 4,11 L 9,11 L 8,18 L 15,9 L 10,9 Z</Geometry>
    <Geometry x:Key="IconWrench">M 12.5,6.5 L 4.5,14.5 L 3,17 L 5.5,15.5 L 13.5,7.5 M 11,4 L 14,2.5 L 17,5 L 15.5,8</Geometry>
    <Geometry x:Key="IconRefresh">M 4,8 A 6,6 0 0 1 14.5,5.5 M 16,12 A 6,6 0 0 1 5.5,14.5 M 14,3 L 14,6 L 17,6 M 6,17 L 6,14 L 3,14</Geometry>
    <Geometry x:Key="IconDriver">M 3,10 A 7,7 0 1 1 17,10 A 7,7 0 1 1 3,10 M 3.5,8 L 16.5,8 M 3.5,12 L 16.5,12</Geometry>
    <Geometry x:Key="IconGrid">M 3,3 L 9,3 L 9,9 L 3,9 Z M 11,3 L 17,3 L 17,9 L 11,9 Z M 3,11 L 9,11 L 9,17 L 3,17 Z M 11,11 L 17,11 L 17,17 L 11,17 Z</Geometry>
    <Geometry x:Key="IconAuto">M 4,7 A 6,6 0 0 1 15,5 M 16,13 A 6,6 0 0 1 5,15 M 15,2 L 15,5 L 12,5 M 5,18 L 5,15 L 8,15</Geometry>
    <Geometry x:Key="IconBackup">M 3,4 L 17,4 L 17,9 L 3,9 Z M 3,11 L 17,11 L 17,16 L 3,16 Z</Geometry>
    <Geometry x:Key="IconClock">M 3,10 A 7,7 0 1 1 17,10 A 7,7 0 1 1 3,10 M 10,6 L 10,10 L 12.6,12</Geometry>
    <Geometry x:Key="IconTools">M 12.5,6.5 L 4.5,14.5 L 3,17 L 5.5,15.5 L 13.5,7.5 M 11,4 L 14,2.5 L 17,5 L 15.5,8</Geometry>
    <Geometry x:Key="IconShield">M 10,2.5 L 16.5,5 L 16.5,10 C 16.5,13.8 13.7,16.6 10,17.5 C 6.3,16.6 3.5,13.8 3.5,10 L 3.5,5 Z M 7.2,10 L 9.2,12 L 12.8,8</Geometry>
    <Geometry x:Key="IconCheck">M 4.5,8.5 L 8,12 L 15,4.5</Geometry>
    <Geometry x:Key="IconMonitor">M 3,4 L 17,4 L 17,14 L 3,14 Z M 7,17 L 13,17 M 10,14 L 10,17</Geometry>
    <Geometry x:Key="IconRam">M 3,7 L 17,7 L 17,14 L 3,14 Z M 6,7 L 6,5 M 10,7 L 10,5 M 14,7 L 14,5</Geometry>
    <Geometry x:Key="IconDisk">M 4,3 L 16,3 L 16,17 L 4,17 Z M 7,6.5 L 13,6.5 M 7,9.5 L 13,9.5</Geometry>
    <Geometry x:Key="IconWifi">M 6.5,11.5 A 5,5 0 0 1 13.5,11.5 M 4,8.5 A 8.5,8.5 0 0 1 16,8.5</Geometry>
    <Geometry x:Key="IconBattery">M 2.5,6.5 L 14.5,6.5 L 14.5,13.5 L 2.5,13.5 Z M 15,8.5 L 17,8.5 L 17,11.5 L 15,11.5</Geometry>
    <Geometry x:Key="IconSearch">M 3.5,9 A 5.5,5.5 0 1 1 14.5,9 A 5.5,5.5 0 1 1 3.5,9 M 13.5,13.5 L 17,17</Geometry>
    <Geometry x:Key="IconArrow">M 2.5,7 L 11.5,7 M 8,3.5 L 11.5,7 L 8,10.5</Geometry>
    <Geometry x:Key="IconBell">M 4,14 L 4,9 A 6,6 0 0 1 16,9 L 16,14 L 17.5,16 L 2.5,16 Z M 8.5,18 A 1.8,1.8 0 0 0 11.5,18</Geometry>
    <Geometry x:Key="IconMoon">M 16.5,12 A 7,7 0 0 1 8,3.5 A 7,7 0 1 0 16.5,12</Geometry>
    <Geometry x:Key="IconCog">M 10,7.4 A 2.6,2.6 0 1 1 10,12.6 A 2.6,2.6 0 1 1 10,7.4 M 10,3 L 10,5 M 10,15 L 10,17 M 3,10 L 5,10 M 15,10 L 17,10 M 5.2,5.2 L 6.6,6.6 M 13.4,13.4 L 14.8,14.8 M 14.8,5.2 L 13.4,6.6 M 6.6,13.4 L 5.2,14.8</Geometry>

    <!-- ============================================================ cards -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource White}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="18,15" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#1E4078" Opacity="0.09" BlurRadius="26" ShadowDepth="7" Direction="270" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Background" Value="{StaticResource White}" />
      <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#1E4078" Opacity="0.05" BlurRadius="14" ShadowDepth="4" Direction="270" />
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================================================ text -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="25" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Sect" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="Tiny" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BigValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- ============================================================ nav -->
    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#5B6B80" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Height" Value="39" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" CornerRadius="12" Padding="14,0" Background="Transparent">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="Ico" Data="{TemplateBinding Tag}" Width="18" Height="18" Stretch="Uniform"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#70FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================================================ buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1D4ED8" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Background" Value="#A8C1EC" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A button on a pale background needs an edge, or it reads as a label. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource White}" />
      <Setter Property="Foreground" Value="#243B57" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="#B9CAE0" BorderThickness="1.2" Padding="{TemplateBinding Padding}">
              <Border.Effect>
                <DropShadowEffect Color="#1E4078" Opacity="0.10" BlurRadius="10" ShadowDepth="2" Direction="270" />
              </Border.Effect>
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#EDF3FC" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#93A3B6" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="#DCE3EC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#DCE9FF" />
      <Setter Property="Foreground" Value="#12448F" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="#8FB6F2" BorderThickness="1.2" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- window caption buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#44546A" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
              <Path Data="{TemplateBinding Tag}" Width="11" Height="11" Stretch="Uniform"
                    Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundIcon" TargetType="Border">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="22" />
      <Setter Property="Background" Value="{StaticResource White}" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#1E4078" Opacity="0.08" BlurRadius="18" ShadowDepth="5" Direction="270" />
        </Setter.Value>
      </Setter>
    </Style>

    <!-- pill / chip -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="11,4" />
      <Setter Property="Background" Value="{StaticResource AccentSoft}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="ThinBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Foreground" Value="{StaticResource AccentBar}" />
      <Setter Property="Background" Value="#EDF0F6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border CornerRadius="4" Background="{TemplateBinding Background}">
              <Border x:Name="PART_Track" CornerRadius="4">
                <Border x:Name="PART_Indicator" CornerRadius="4" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
              </Border>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#55889FBF" CornerRadius="4" Width="6" HorizontalAlignment="Center" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="36" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource White}" />
    </Style>

  </Application.Resources>
</Application>
