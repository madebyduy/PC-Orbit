<Application x:Class="PcOrbit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!--
      ================================================================= design system

      Two surfaces, deliberately far apart in value: a deep navy rail that reads as the
      instrument, and a near-white canvas that reads as the readout. Contrast between the two is
      what makes a tool look considered rather than merely tinted, and it keeps the content — which
      is what people came for — the brightest thing on screen.

      One accent. The previous palette had five (blue, violet, cyan, orange, green) all competing
      at full saturation, which is why nothing on a page felt more important than anything else.
      Indigo is now the only colour that means "act on this"; green, amber and red are reserved for
      states the machine reported, and violet and cyan survive as data-series colours only.
    -->

    <!-- ============================================================ ink -->
    <SolidColorBrush x:Key="Ink" Color="#0F172A" />
    <SolidColorBrush x:Key="Muted" Color="#64748B" />
    <SolidColorBrush x:Key="Faint" Color="#94A3B8" />
    <SolidColorBrush x:Key="Hair" Color="#E9EDF3" />

    <!-- ============================================================ accent -->
    <SolidColorBrush x:Key="Accent" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentDeep" Color="#3730A3" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EEF0FE" />

    <!-- ============================================================ state -->
    <SolidColorBrush x:Key="Good" Color="#047857" />
    <SolidColorBrush x:Key="GoodSoft" Color="#E7F6F0" />
    <SolidColorBrush x:Key="Warn" Color="#A16207" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FCF4E4" />
    <SolidColorBrush x:Key="Bad" Color="#B91C1C" />
    <SolidColorBrush x:Key="BadSoft" Color="#FDECEC" />

    <!-- Data-series only. Never used to mean "important". -->
    <SolidColorBrush x:Key="Violet" Color="#7C3AED" />
    <SolidColorBrush x:Key="VioletSoft" Color="#F3EEFE" />
    <SolidColorBrush x:Key="Cyan" Color="#0891B2" />
    <SolidColorBrush x:Key="CyanSoft" Color="#E4F5F9" />
    <SolidColorBrush x:Key="Orange" Color="#C2410C" />
    <SolidColorBrush x:Key="OrangeSoft" Color="#FCEFE8" />

    <!-- ============================================================ surfaces -->
    <SolidColorBrush x:Key="White" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />

    <!--
      The zebra stripe behind list rows. It was referenced from six places and defined in none, so
      opening Plan &amp; Apply threw a XamlParseException the moment a plan rendered — a
      DataTemplate is parsed when it is first applied, which is why nothing failed at startup.
    -->
    <SolidColorBrush x:Key="RowBg" Color="#F8FAFC" />
    <SolidColorBrush x:Key="RowHover" Color="#F1F5F9" />

    <!-- the rail -->
    <SolidColorBrush x:Key="SideBg" Color="#0B1220" />
    <SolidColorBrush x:Key="SideInk" Color="#1B1B1F" />
    <SolidColorBrush x:Key="SideMuted" Color="#5C6270" />
    <SolidColorBrush x:Key="SideHair" Color="#E3E5EC" />

    <SolidColorBrush x:Key="NavActive" Color="#E6E6EE" />

    <SolidColorBrush x:Key="SideFill" Color="#00FFFFFF" />

    <!--
      The canvas. Two soft colour fields drifting across an off-white, the way Windows 11's Mica
      lets the wallpaper bleed through the frame. Low enough contrast that white cards still sit
      clearly on top; high enough that the page is not a flat grey.
    -->
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#EEF0F8" Offset="0" />
      <GradientStop Color="#F3F3F7" Offset="0.5" />
      <GradientStop Color="#EDF2F6" Offset="1" />
    </LinearGradientBrush>

    <!-- The two Mica glows laid over the canvas. Painted once, behind everything. -->
    <RadialGradientBrush x:Key="GlowIndigo" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
      <GradientStop Color="#5A6366F1" Offset="0" />
      <GradientStop Color="#006366F1" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowCyan" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
      <GradientStop Color="#4A22D3EE" Offset="0" />
      <GradientStop Color="#0022D3EE" Offset="1" />
    </RadialGradientBrush>

    <!-- A card edge that darkens toward the bottom, standing in for a shadow. -->
    <LinearGradientBrush x:Key="CardEdge" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#F1F4F9" Offset="0" />
      <GradientStop Color="#DCE3EE" Offset="1" />
    </LinearGradientBrush>

    <!-- Glass tile fill for the live gauges: a whisper of the accent at the top edge. -->
    <LinearGradientBrush x:Key="TileFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFF" Offset="0" />
      <GradientStop Color="#FAFBFE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LogoBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#818CF8" Offset="0" />
      <GradientStop Color="#4F46E5" Offset="1" />
    </LinearGradientBrush>

    <!-- The one place a wash is allowed: the hero, which has no data competing with it. -->
    <LinearGradientBrush x:Key="HeroBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1B1F4B" Offset="0" />
      <GradientStop Color="#312E81" Offset="0.5" />
      <GradientStop Color="#4338CA" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="HeroGlow" GradientOrigin="0.8,0.1" Center="0.8,0.1" RadiusX="0.7" RadiusY="1.1">
      <GradientStop Color="#66A5B4FC" Offset="0" />
      <GradientStop Color="#00A5B4FC" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="AccentBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#818CF8" Offset="0" />
      <GradientStop Color="#4F46E5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="VioletBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#A78BFA" Offset="0" />
      <GradientStop Color="#7C3AED" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrangeBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FB923C" Offset="0" />
      <GradientStop Color="#C2410C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoodBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#34D399" Offset="0" />
      <GradientStop Color="#047857" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CyanBar" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#22D3EE" Offset="0" />
      <GradientStop Color="#0891B2" Offset="1" />
    </LinearGradientBrush>

    <!--
      ============================================================ icons
      Windows' own icon font, so the app draws with the same strokes as Settings and Explorer.
      Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets underneath it on 10 - same code points.
    -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:String x:Key="GlyphHome">&#xE80F;</sys:String>
    <sys:String x:Key="GlyphStatus">&#xE9D9;</sys:String>
    <sys:String x:Key="GlyphHardware">&#xE950;</sys:String>
    <sys:String x:Key="GlyphPerf">&#xEC4A;</sys:String>
    <sys:String x:Key="GlyphSecurity">&#xEA18;</sys:String>
    <sys:String x:Key="GlyphRecovery">&#xEC7A;</sys:String>
    <sys:String x:Key="GlyphCleanup">&#xE74D;</sys:String>
    <sys:String x:Key="GlyphStartup">&#xE7E8;</sys:String>
    <sys:String x:Key="GlyphDrivers">&#xE9F5;</sys:String>
    <sys:String x:Key="GlyphPlan">&#xE945;</sys:String>
    <sys:String x:Key="GlyphTimeline">&#xE81C;</sys:String>
    <sys:String x:Key="GlyphCompare">&#xE8AB;</sys:String>
    <!--
      Catalogue categories. Every code point below was checked against both SegoeIcons.ttf and
      segmdl2.ttf before being used: a glyph the font does not have renders as an empty box, which
      is a worse icon than no icon.
    -->
    <sys:String x:Key="GlyphBrowser">&#xE774;</sys:String>
    <sys:String x:Key="GlyphMedia">&#xE768;</sys:String>
    <sys:String x:Key="GlyphUtility">&#xE912;</sys:String>
    <sys:String x:Key="GlyphChat">&#xE8BD;</sys:String>
    <sys:String x:Key="GlyphCode">&#xE943;</sys:String>
    <sys:String x:Key="GlyphPackage">&#xE7B8;</sys:String>
    <sys:String x:Key="GlyphCpu">&#xE950;</sys:String>
    <sys:String x:Key="GlyphRam">&#xEEA0;</sys:String>
    <sys:String x:Key="GlyphDisk">&#xEDA2;</sys:String>
    <sys:String x:Key="GlyphNet">&#xE701;</sys:String>
    <sys:String x:Key="GlyphCheck">&#xE73E;</sys:String>
    <sys:String x:Key="GlyphRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="GlyphAdmin">&#xE7EF;</sys:String>
    <sys:String x:Key="GlyphClock">&#xE823;</sys:String>
    <sys:String x:Key="GlyphMonitor">&#xE7F4;</sys:String>
    <sys:String x:Key="GlyphAudio">&#xE767;</sys:String>
    <sys:String x:Key="GlyphKeyboard">&#xE765;</sys:String>
    <sys:String x:Key="GlyphGpu">&#xE9D9;</sys:String>
    <sys:String x:Key="GlyphSearch">&#xE721;</sys:String>
    <sys:String x:Key="GlyphSpark">&#xE945;</sys:String>
    <sys:String x:Key="GlyphWarn">&#xE7BA;</sys:String>
    <sys:String x:Key="GlyphInfo">&#xE946;</sys:String>
    <sys:String x:Key="GlyphFolder">&#xE8B7;</sys:String>
    <sys:String x:Key="GlyphChevron">&#xE76C;</sys:String>
    <sys:String x:Key="GlyphList">&#xE9D5;</sys:String>

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <!-- ============================================================ path icons (legacy) -->
    <Geometry x:Key="IconHome">M 3,9 L 10,3 L 17,9 L 17,17 L 3,17 Z</Geometry>
    <Geometry x:Key="IconGauge">M 3,10 A 7,7 0 1 1 17,10 M 10,10 L 13.5,6.5</Geometry>
    <Geometry x:Key="IconChip">M 5,5 L 15,5 L 15,15 L 5,15 Z M 8,2 L 8,5 M 12,2 L 12,5 M 8,15 L 8,18 M 12,15 L 12,18 M 2,8 L 5,8 M 2,12 L 5,12 M 15,8 L 18,8 M 15,12 L 18,12</Geometry>
    <Geometry x:Key="IconSpark">M 11,2 L 4,11 L 9,11 L 8,18 L 15,9 L 10,9 Z</Geometry>
    <Geometry x:Key="IconWrench">M 12.5,6.5 L 4.5,14.5 L 3,17 L 5.5,15.5 L 13.5,7.5 M 11,4 L 14,2.5 L 17,5 L 15.5,8</Geometry>
    <Geometry x:Key="IconRefresh">M 4,8 A 6,6 0 0 1 14.5,5.5 M 16,12 A 6,6 0 0 1 5.5,14.5 M 14,3 L 14,6 L 17,6 M 6,17 L 6,14 L 3,14</Geometry>
