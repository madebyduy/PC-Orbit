<Application x:Class="PcOrbit.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- The PC Control palette from the reference design. -->
    <Color x:Key="InkColor">#1E2B3C</Color>
    <SolidColorBrush x:Key="Ink" Color="#1E2B3C" />
    <SolidColorBrush x:Key="Muted" Color="#6B7A8F" />
    <SolidColorBrush x:Key="Faint" Color="#8A99AD" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EAF2FF" />
    <SolidColorBrush x:Key="Good" Color="#0F9D6E" />
    <SolidColorBrush x:Key="GoodSoft" Color="#E3F8EF" />
    <SolidColorBrush x:Key="Warn" Color="#B45309" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FDF5E6" />
    <SolidColorBrush x:Key="Bad" Color="#C42B1C" />
    <SolidColorBrush x:Key="CardBg" Color="#F4FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RowBg" Color="#F8FAFD" />
    <LinearGradientBrush x:Key="PageBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#EAF1FB" Offset="0" />
      <GradientStop Color="#E7EFFA" Offset="0.45" />
      <GradientStop Color="#E9F2F6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LogoBg" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#60A5FA" Offset="0" />
      <GradientStop Color="#2563EB" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#1E4078" Opacity="0.08" BlurRadius="24" ShadowDepth="6" Direction="270" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#5B6B80" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" CornerRadius="12" Padding="14,0" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#66FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1D4ED8" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Background" Value="#9DB8E8" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#44546A" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#E3EAF3" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#F2F6FC" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#A9B6C6" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

  </Application.Resources>
</Application>
