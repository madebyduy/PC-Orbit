<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>PcOrbit.App</RootNamespace>
    <AssemblyName>PcOrbit</AssemblyName>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      Required by [LibraryImport], whose generated marshalling stubs are unsafe internally. This
      project has exactly one P/Invoke — asking DWM to round the window's corners — and the
      alternative was suppressing the analyzer that asks for LibraryImport in the first place.
      Nothing in this project is written unsafe; the switch only permits the generated code.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Trim the managed heap aggressively. A desktop tool that idles in the tray-adjacent corner of
      someone's day should not hold 300 MB because the GC saw no pressure; 5 tells the runtime to
      keep the heap near what is live rather than near what was recently allocated.
    -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.Concurrent" Value="false" />
    <!--
      Profile-guided tiering instruments hot methods and keeps the instrumentation alive. Worth it
      for a server; for a desktop tool that is mostly waiting on the user it is memory spent
      optimising code that runs a few times an hour.
    -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredPGO" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The CLI project is the composition root: the executor allowlist lives in PcOrbitHost and
         nowhere else (spec 19.1). The app reuses it rather than growing a second allowlist. -->
    <ProjectReference Include="..\PcOrbit.Cli\PcOrbit.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\**\*.json" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
